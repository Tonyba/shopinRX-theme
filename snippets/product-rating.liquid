{{ 'product-rating.css' | asset_url | stylesheet_tag }}

{% liquid
  assign float_number = product.metafields.reviews.rating.value | split: '.'
  assign first_digit = float_number[0] | append: '.'
  assign second_digit = float_number[1]
  assign max_stars = 5

  assign rating = first_digit | append: second_digit
  assign filled_stars_amount = rating | plus: 0 | floor

  assign empty_stars_amount = max_stars | minus: filled_stars_amount
%}

<div
  class="rating"
  role="img"
  aria-label="{{ 'accessibility.star_reviews_info' | t: rating_value: product.metafields.reviews.rating.value, rating_max: product.metafields.reviews.rating.value.scale_max }}"
>
  {% for item in (1..filled_stars_amount) %}
    {% render 'icon-star-filled-rating' %}
  {% endfor %}
  {% for item in (1..empty_stars_amount) %}
    {% render 'icon-star-empty-rating' %}
  {% endfor %}
</div>
<p class="rating-text caption">
  <span aria-hidden="true">
    {{- product.metafields.reviews.rating.value }} /
    {{ product.metafields.reviews.rating.value.scale_max -}}
  </span>
</p>
<p class="rating-count caption">
  <span class="visually-hidden">
    {{- product.metafields.reviews.rating_count }}
    {{ 'accessibility.total_reviews' | t -}}
  </span>
</p>
