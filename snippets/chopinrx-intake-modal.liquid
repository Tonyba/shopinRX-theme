{% doc %}
  Intake modal. Every "Start intake" link that points at a MyDose
  book-consultation URL opens here, in an iframe on intake.chopinwellness.com,
  instead of leaving the site. Centred panel on desktop and tablet, full screen
  on mobile. Rendered once in layout/theme.liquid.

  @example
  {% render 'chopinrx-intake-modal' %}
{% enddoc %}

<dialog class="chx-intake" aria-labelledby="ChxIntakeTitle" data-chx-intake>
  <div class="chx-intake__bar">
    <button type="button" class="chx-intake__back" data-chx-intake-close>
      <span class="chx-intake__back-icon" aria-hidden="true">
        {{- 'icon-arrow-right.svg' | inline_asset_content -}}
      </span>
      <span>Back</span>
    </button>
    <p class="chx-intake__title" id="ChxIntakeTitle">Start your intake</p>
    <button type="button" class="chx-intake__close" aria-label="Close intake" data-chx-intake-close>
      <span aria-hidden="true">{{- 'icon-close.svg' | inline_asset_content -}}</span>
    </button>
  </div>
  <div class="chx-intake__body">
    <p class="chx-intake__loading" aria-hidden="true">Loading…</p>
    <iframe
      class="chx-intake__frame"
      title="Patient intake form"
      allow="camera; microphone; payment; clipboard-write; fullscreen"
      data-chx-intake-frame
    ></iframe>
  </div>
</dialog>

<script src="{{ 'chopinrx-intake-modal.js' | asset_url }}" defer></script>

{% stylesheet %}
  .chx-intake {
    width: min(960px, calc(100vw - 2 * var(--space-6)));
    max-width: none;
    height: min(880px, calc(100dvh - 2 * var(--space-6)));
    max-height: none;
    padding: 0;
    border: 0;
    border-radius: var(--radius-xl);
    background-color: var(--surface-page);
    color: var(--text-body);
    box-shadow: 0 24px 64px rgb(20 24 29 / 28%);
    overflow: hidden;
  }

  .chx-intake[open] {
    display: flex;
    flex-direction: column;
    animation: chx-intake-in 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chx-intake::backdrop {
    background-color: rgb(20 24 29 / 60%);
  }

  @keyframes chx-intake-in {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
  }

  .chx-intake__bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-3);
    flex: none;
    padding: var(--space-3) var(--space-4);
    border-block-end: var(--border-w, 1px) solid var(--border-hairline);
  }

  .chx-intake .chx-intake__title {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 600;
    color: var(--text-heading);
    text-align: center;
  }

  .chx-intake__back,
  .chx-intake__close {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: 0 var(--space-2);
    border: 0;
    border-radius: var(--radius-md);
    background: none;
    color: var(--text-heading);
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 500;
    cursor: pointer;
  }

  .chx-intake__back {
    justify-self: start;
  }

  .chx-intake__close {
    justify-self: end;
    justify-content: center;
    min-width: 44px;
  }

  .chx-intake__back:hover,
  .chx-intake__close:hover {
    background-color: var(--surface-muted);
  }

  .chx-intake__back:focus-visible,
  .chx-intake__close:focus-visible {
    outline: 2px solid var(--action-primary-bg);
    outline-offset: 2px;
  }

  .chx-intake__back-icon,
  .chx-intake__close svg {
    display: block;
    width: 18px;
    height: 18px;
  }

  .chx-intake__back-icon {
    transform: rotate(180deg);
  }

  .chx-intake__back-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chx-intake__body {
    position: relative;
    flex: 1 1 auto;
    min-height: 0;
  }

  .chx-intake__loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-body-small);
  }

  .chx-intake__frame {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background-color: transparent;
  }

  html:has(.chx-intake[open]),
  html:has(.chx-intake[open]) .page-wrapper {
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .chx-intake[open] {
      animation: none;
    }
  }

  @media screen and (max-width: 1024px) {
    .chx-intake {
      width: calc(100vw - 2 * var(--space-4));
      height: calc(100dvh - 2 * var(--space-4));
    }
  }

  @media screen and (max-width: 767px) {
    .chx-intake {
      width: 100vw;
      height: 100dvh;
      margin: 0;
      border-radius: 0;
      box-shadow: none;
    }

    .chx-intake__bar {
      padding: var(--space-2) var(--space-3);
      padding-block-start: calc(var(--space-2) + env(safe-area-inset-top, 0px));
    }

    .chx-intake__frame {
      padding-block-end: env(safe-area-inset-bottom, 0px);
    }
  }
{% endstylesheet %}
