{% doc %}
  Cart cross-sell. Lists non-prescription supplements next to the cart: the
  ones paired with the products in the cart first, then other supplements to
  fill the list, each with its own add form.

  Pairings come from each cart product's custom.pairs_with metafield. When the
  cart products have none, or fewer than the limit, the fallback collection
  fills the remaining slots; without a fallback collection the whole catalogue
  is used. The starting point rotates each day so the fill is not always the
  same few products. Products already in the cart, unavailable products and
  prescription products (tagged `rx` or in the Rx collections from the theme
  settings) are never offered, so the Rx / intake flow is untouched.

  Rendered inside the cart drawer, so it re-renders with every cart change.

  @example
  {% render 'chopinrx-cart-upsell' %}
{% enddoc %}

{%- liquid
  assign rx_handles = settings.cart_upsell_rx_collections | downcase | replace: ' ', '' | split: ','
  assign limit = settings.cart_upsell_limit | default: 3
  assign cart_ids = cart.items | map: 'product_id'
  assign seen = ''
  assign shown = 0
-%}

{%- if settings.cart_upsell_enabled and cart.item_count > 0 -%}
  {%- capture rows -%}
    {%- comment -%} 1. Products paired with what is in the cart. {%- endcomment -%}
    {%- for item in cart.items -%}
      {%- for pick in item.product.metafields.custom.pairs_with.value -%}
        {%- if shown >= limit -%}
          {%- break -%}
        {%- endif -%}
        {%- liquid
          assign marker = pick.id | prepend: '|' | append: '|'
          assign pick_rx = false
          if pick.tags contains 'rx'
            assign pick_rx = true
          endif
          for c in pick.collections
            if rx_handles contains c.handle
              assign pick_rx = true
            endif
          endfor
          if pick_rx or pick.available == false or cart_ids contains pick.id or seen contains marker
            continue
          endif
          assign seen = seen | append: marker
          assign shown = shown | plus: 1
        -%}
        {%- render 'chopinrx-cart-upsell-item', product: pick -%}
      {%- endfor -%}
    {%- endfor -%}

    {%- comment -%}
      2. Fill from the fallback collection, or the whole catalogue, starting
      at a point that moves every day so the picks vary.
    {%- endcomment -%}
    {%- if shown < limit -%}
      {%- liquid
        if settings.cart_upsell_collection != blank
          assign pool = settings.cart_upsell_collection.products
          assign pool_size = settings.cart_upsell_collection.all_products_count
        else
          assign pool = collections.all.products
          assign pool_size = collections.all.all_products_count
        endif
        assign start = 0
        if pool_size > 0
          assign start = 'now' | date: '%j' | plus: 0 | modulo: pool_size
        endif
      -%}
      {%- for pass in (1..2) -%}
        {%- if shown >= limit -%}
          {%- break -%}
        {%- endif -%}
        {%- for pick in pool offset: start -%}
          {%- if shown >= limit -%}
            {%- break -%}
          {%- endif -%}
          {%- liquid
            assign marker = pick.id | prepend: '|' | append: '|'
            assign pick_rx = false
            if pick.tags contains 'rx'
              assign pick_rx = true
            endif
            for c in pick.collections
              if rx_handles contains c.handle
                assign pick_rx = true
              endif
            endfor
            if pick_rx or pick.available == false or cart_ids contains pick.id or seen contains marker
              continue
            endif
            assign seen = seen | append: marker
            assign shown = shown | plus: 1
          -%}
          {%- render 'chopinrx-cart-upsell-item', product: pick -%}
        {%- endfor -%}
        {%- comment -%} The second pass wraps round to the start of the pool. {%- endcomment -%}
        {%- assign start = 0 -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- if shown > 0 -%}
    <aside class="chx-upsell" aria-labelledby="chx-upsell-heading">
      <div class="chx-upsell__header">
        <h3 class="chx-upsell__heading" id="chx-upsell-heading">{{ settings.cart_upsell_heading }}</h3>
        {%- if settings.cart_upsell_subheading != blank -%}
          <p class="chx-upsell__sub">{{ settings.cart_upsell_subheading }}</p>
        {%- endif -%}
      </div>
      <ul class="chx-upsell__list" role="list">
        {{ rows }}
      </ul>
    </aside>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .chx-upsell {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-6) var(--cart-drawer-padding, var(--space-6)) 0;
    margin-block-start: var(--space-6);
    border-block-start: var(--border-w) solid var(--border-hairline);
  }

  .chx-upsell__header {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .chx-upsell__heading {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-subtitle);
    font-weight: 500;
    line-height: 1.28;
    letter-spacing: -0.02em;
    color: var(--text-heading);
  }

  .chx-upsell__sub {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 500;
    line-height: 1.43;
    letter-spacing: -0.005em;
    color: var(--text-muted);
  }

  .chx-upsell__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-upsell__item {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-3);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
  }

  .chx-upsell__media {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--radius-md);
    background-color: var(--surface-well);
    overflow: clip;
  }

  .chx-upsell__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-upsell__placeholder {
    font-family: var(--font-display);
    font-size: var(--font-size-h5);
    font-weight: 500;
    color: var(--text-muted);
  }

  .chx-upsell__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .chx-upsell__title {
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-heading);
    text-decoration: none;
  }

  .chx-upsell__title:hover {
    color: var(--text-accent);
    text-decoration: none;
  }

  .chx-upsell__text {
    display: -webkit-box;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 400;
    line-height: 1.43;
    letter-spacing: -0.005em;
    color: var(--text-muted);
    overflow: hidden;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .chx-upsell__price {
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 600;
    line-height: 1.43;
    letter-spacing: -0.005em;
    font-variant-numeric: tabular-nums;
    color: var(--text-heading);
  }

  .chx-upsell__form {
    margin: 0;
  }

  /* Scoped under the block so it out-ranks the shared button primitive. */
  .chx-upsell .chx-upsell__add {
    height: 40px;
    padding-inline: var(--space-4);
    font-size: var(--font-size-body-small);
    line-height: 1.43;
  }

  .chx-upsell .product-form-text__error {
    display: none;
  }
{% endstylesheet %}
