{% doc %}
  Scroll-to-top button. Sits in the bottom-right corner, appears once the page
  has been scrolled past the first screen and stacks above the floating cart
  button while that one is showing.

  @example
  {% render 'chopinrx-scroll-top' %}
{% enddoc %}

{% render 'chopinrx-tokens' %}

<button
  type="button"
  class="chx-top"
  aria-label="{{ 'accessibility.back_to_top' | t }}"
  data-chx-top
>
  <span class="chx-top__icon" aria-hidden="true">
    {{- 'icon-arrow-down.svg' | inline_asset_content -}}
  </span>
</button>

<script src="{{ 'chopinrx-scroll-top.js' | asset_url }}" defer></script>

{% stylesheet %}
  .chx-top {
    /* Centred on the floating cart's column (60px button, 48px here). */
    --chx-top-offset: var(--space-6);
    --chx-top-inset: calc(var(--space-6) + 6px);

    position: fixed;
    inset-block-end: calc(var(--chx-top-offset) + var(--safe-area-inset-bottom, 0px));
    inset-inline-end: calc(var(--chx-top-inset) + var(--safe-area-inset-right, 0px));
    z-index: var(--layer-overlay, 16);
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background-color: var(--surface-dark);
    color: var(--text-on-dark);
    box-shadow: 0 8px 24px rgb(20 24 29 / 24%);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transform: translateY(16px) scale(0.9);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s ease, visibility 0s linear 0.25s,
      background-color 0.2s ease, inset-block-end 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .chx-top[data-visible] {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  /* Floating cart is 60px tall at 24px from the bottom; keep a 12px gap above it. */
  body:has(.chx-fab:not([hidden])) .chx-top {
    --chx-top-offset: calc(var(--space-6) + 60px + var(--space-3));
  }

  .chx-top:hover {
    background-color: var(--action-primary-bg-hover);
  }

  .chx-top:active {
    transform: scale(0.96);
  }

  .chx-top:focus-visible {
    outline: 2px solid var(--action-primary-bg);
    outline-offset: 3px;
  }

  .chx-top__icon {
    display: block;
    width: 22px;
    height: 22px;
    transform: rotate(180deg);
  }

  .chx-top__icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    .chx-top {
      transition: none;
    }
  }

  @media screen and (max-width: 767px) {
    .chx-top {
      /* Mobile floating cart is 56px; 44px here. */
      --chx-top-offset: var(--space-4);
      --chx-top-inset: calc(var(--space-4) + 6px);

      width: 44px;
      height: 44px;
    }

    body:has(.chx-fab:not([hidden])) .chx-top {
      --chx-top-offset: calc(var(--space-4) + 56px + var(--space-3));
    }
  }
{% endstylesheet %}
