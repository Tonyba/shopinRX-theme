{% doc %}
  Renders the shared SectionHeading block: an optional eyebrow (accent dot +
  muted label) above a heading.

  @param {string} [eyebrow] - Eyebrow label. Omitted when blank.
  @param {string} heading - Heading text.
  @param {string} [heading_tag] - Heading element, defaults to 'h2'.
  @param {string} [heading_class] - Type class for the heading, defaults to 'chx-h2'.
  @param {string} [body] - Optional supporting copy rendered under the heading.
  @param {boolean} [centered] - Centres the block and caps the measure at 900px.
  @param {string} [class] - Extra classes for the wrapper.

  @example
  {% render 'chopinrx-section-heading', eyebrow: 'Flagship Programs', heading: 'Start With A Flagship Program' %}
{% enddoc %}

{% liquid
  assign tag = heading_tag | default: 'h2'
  assign type_class = heading_class | default: 'chx-h2'
%}

<div class="chx-section-heading{% if centered %} chx-section-heading--centered{% endif %}{% if class %} {{ class }}{% endif %}">
  {%- if eyebrow != blank -%}
    <p class="chx-eyebrow">
      <span class="chx-eyebrow__dot" aria-hidden="true">
        {{- 'icon-eyebrow-dot.svg' | inline_asset_content -}}
      </span>
      <span class="chx-eyebrow__text">{{ eyebrow }}</span>
    </p>
  {%- endif -%}

  {%- if heading != blank -%}
    <{{ tag }} class="{{ type_class }} chx-section-heading__title">{{ heading }}</{{ tag }}>
  {%- endif -%}

  {%- if body != blank -%}
    <div class="chx-body-lg chx-section-heading__body">{{ body }}</div>
  {%- endif -%}
</div>

{% stylesheet %}
  .chx-section-heading {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .chx-section-heading--centered {
    align-items: center;
    max-width: 900px;
    margin-inline: auto;
    text-align: center;
  }

  .chx-eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
  }

  .chx-eyebrow__dot {
    display: block;
    flex-shrink: 0;
    width: 15.3333px;
    height: 15.3333px;
  }

  .chx-eyebrow__dot svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chx-eyebrow__text {
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-muted);
  }

  /* Headings take the accent on a selected clause. Authored as <em> in an
     inline_richtext setting, rendered as colour rather than italics. */
  .chx-section-heading__title em,
  .chx-accent-clause {
    font-style: normal;
    color: var(--text-accent);
  }

  .chx-section-heading__body {
    color: var(--text-muted);
  }

  .chx-section-heading__body > :first-child {
    margin-block-start: 0;
  }

  .chx-section-heading__body > :last-child {
    margin-block-end: 0;
  }

  @media screen and (max-width: 767px) {
    .chx-section-heading {
      gap: var(--space-3);
    }

    .chx-eyebrow__text {
      font-size: var(--font-size-body-small);
    }
  }
{% endstylesheet %}
