    "faq": {
      "type": "chopinrx-faq",
      "blocks": {
        "question_1": {
          "type": "question",
          "settings": {
            "question": "How does ChopinRX work?",
            "answer": "<p>Choose a goal-based program or individual treatment and complete a secure online medical intake. ChopinRX connects you with an independent, licensed clinician who reviews your information and determines whether treatment is appropriate. If prescribed, a licensed U.S. pharmacy fulfills and ships your treatment.</p><h3></h3>",
            "open": true
          }
        },
        "question_2": {
          "type": "question",
          "settings": {
            "question": "Does ChopinRX provide medical care or prescribe medication?",
            "answer": "<p>No. ChopinRX is a technology and lead-generation platform that helps connect consumers with independent, licensed medical providers. Those providers—not ChopinRX—evaluate patients, make prescribing decisions, and direct medical care.</p>",
            "open": false
          }
        },
        "question_3": {
          "type": "question",
          "settings": {
            "question": "Who decides what I am prescribed?",
            "answer": "<p>All prescribing decisions are made by the independent licensed clinician who reviews your health information. Choosing a program or treatment on the website does not guarantee that it will be prescribed.</p>",
            "open": false
          }
        },
        "question_4": {
          "type": "question",
          "settings": {
            "question": "What is the difference between a program and an individual treatment?",
            "answer": "<p>A program groups several potential treatment options around a specific goal, while an individual treatment page focuses on one medication or product. In either case, an independent clinician determines what, if anything, is medically appropriate for you.</p>",
            "open": false
          }
        },
        "question_5": {
          "type": "question",
          "settings": {
            "question": "Will I need laboratory testing?",
            "answer": "<p>It depends on the treatment, your medical history, and the clinician’s judgment. Some options may require laboratory testing before treatment begins or during follow-up.</p>",
            "open": false
          }
        }
      },
