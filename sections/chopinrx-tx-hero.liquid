{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign plus_icon = 'icon-faq-plus.svg' | inline_asset_content
  assign minus_icon = 'icon-faq-minus.svg' | inline_asset_content
  assign check_icon = 'icon-tx-check-box.svg' | inline_asset_content
  assign variant = product.selected_or_first_available_variant

  assign eyebrow = product.metafields.custom.goal.value | default: section.settings.eyebrow
  assign summary = product.metafields.custom.summary.value
  if summary == blank
    assign summary = product.description | strip_html | truncatewords: 24
  endif

  assign image = section.settings.image | default: product.featured_media.preview_image

  assign intake_url = variant.metafields.custom.mydos_link.value | default: product.metafields.custom.mydos_link.value | default: '' | strip
  assign coming_soon = false
  if intake_url == blank or product.tags contains 'coming-soon'
    assign coming_soon = true
  endif

  assign rows = product.metafields.custom.detail_rows.value
  if rows.size > 0
    assign details = empty
  else
    assign details = section.blocks | where: 'type', 'detail'
  endif
  assign badges = section.blocks | where: 'type', 'badge'
%}

<div class="chx-tx chx-txhero">
  <div class="chx-txhero__media">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 1600
        | image_tag:
          widths: '500, 800, 1100, 1400, 1600',
          sizes: '(max-width: 1024px) 100vw, 50vw',
          loading: 'eager',
          fetchpriority: 'high',
          class: 'chx-txhero__image',
          alt: product.featured_media.alt | default: product.title
      }}
    {%- else -%}
      <span class="chx-txhero__placeholder">{{ section.settings.placeholder_label }}</span>
    {%- endif -%}
  </div>

  <div class="chx-txhero__content">
    <div class="chx-txhero__inner">
      {%- if eyebrow != blank -%}
        <p class="chx-txhero__eyebrow">
          <span class="chx-eyebrow__dot" aria-hidden="true">{{- 'icon-eyebrow-dot.svg' | inline_asset_content -}}</span>
          <span>{{ eyebrow }}</span>
        </p>
      {%- endif -%}

      <h1 class="chx-txtitle chx-txhero__title">{{ product.title }}</h1>

      {%- if summary != blank -%}
        <p class="chx-body-lg chx-txhero__summary">{{ summary }}</p>
      {%- endif -%}

      {%- if coming_soon -%}
        <span class="chx-txbtn chx-txhero__cta" role="button" aria-disabled="true">
          {{ section.settings.soon_label }}
        </span>
      {%- else -%}
        <a class="chx-txbtn chx-txhero__cta" href="{{ intake_url }}">
          <span>{{ section.settings.cta_label }}</span>
          <span class="chx-txhero__cta-sep" aria-hidden="true">|</span>
          <span>
            {{ section.settings.price_prefix }}
            {{ product.price_min | money_without_trailing_zeros -}}
            {{- section.settings.price_unit }}
          </span>
          {%- if product.compare_at_price_min > product.price_min -%}
            <s class="chx-txhero__cta-compare">
              <span class="visually-hidden">{{ section.settings.compare_label }}</span>
              {{- product.compare_at_price_min | money_without_trailing_zeros -}}
            </s>
          {%- endif -%}
        </a>
      {%- endif -%}

      {%- assign course = product.metafields.custom.course_length.value -%}
      {%- if badges.size > 0 or course != blank -%}
        <ul class="chx-txhero__badges" role="list">
          {%- for block in badges -%}
            <li class="chx-txhero__badge" {{ block.shopify_attributes }}>
              <span class="chx-txhero__badge-icon" aria-hidden="true">{{ check_icon }}</span>
              <span>{{ block.settings.text }}</span>
            </li>
          {%- endfor -%}
          {%- if course != blank -%}
            <li class="chx-txhero__badge chx-txhero__badge--muted">
              {{ section.settings.course_label }}
              {{ course }}
            </li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if rows.size > 0 or details.size > 0 -%}
        <div class="chx-faq__list chx-txacc chx-txhero__details">
          {%- for row in rows -%}
            <details class="chx-faq__item" {% if row.open.value %}open{% endif %}>
              <summary class="chx-faq__question">
                <span class="chx-faq__question-text">{{ row.heading.value }}</span>
                <span class="chx-faq__toggle" aria-hidden="true">
                  <span class="chx-faq__toggle-icon chx-faq__toggle-icon--closed">{{ plus_icon }}</span>
                  <span class="chx-faq__toggle-icon chx-faq__toggle-icon--open">{{ minus_icon }}</span>
                </span>
              </summary>
              <div class="chx-faq__answer">{% render 'chopinrx-rich-block', field: row.content %}</div>
            </details>
          {%- endfor -%}
          {%- for block in details -%}
            {%- liquid
              assign content = blank
              if block.settings.source == 'description'
                assign content = product.description
              endif
              if content == blank
                assign content = block.settings.content
              endif
              assign heading = block.settings.heading | replace: '[product]', product.title
            -%}
            {%- if content != blank -%}
              <details class="chx-faq__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
                <summary class="chx-faq__question">
                  <span class="chx-faq__question-text">{{ heading }}</span>
                  <span class="chx-faq__toggle" aria-hidden="true">
                    <span class="chx-faq__toggle-icon chx-faq__toggle-icon--closed">{{ plus_icon }}</span>
                    <span class="chx-faq__toggle-icon chx-faq__toggle-icon--open">{{ minus_icon }}</span>
                  </span>
                </summary>
                <div class="chx-faq__answer">{{ content }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% stylesheet %}
  .chx-txhero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(860px, calc(100svh - var(--chx-top-offset, 80px)));
    background: var(--surface-card);
  }

  .chx-txhero__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: var(--surface-muted);
  }

  .chx-txhero .chx-txhero__image {
    width: 100%;
    height: 100%;
    max-height: 860px;
    object-fit: cover;
  }

  .chx-txhero__placeholder {
    color: var(--text-muted);
    font-size: var(--font-size-body-small);
  }

  .chx-txhero__content {
    display: flex;
    align-items: center;
    padding: var(--space-16) var(--chx-gutter) var(--space-16) var(--space-16);
  }

  .chx-txhero__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
    max-width: 560px;
  }

  .chx-txhero__eyebrow {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--text-accent);
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .chx-txhero .chx-txhero__title {
    text-transform: none;
  }

  .chx-txhero .chx-txhero__summary {
    margin: 0;
    color: var(--text-body);
  }

  .chx-txhero .chx-txhero__cta {
    width: 100%;
    min-height: 56px;
  }

  .chx-txhero__cta-sep {
    opacity: 0.5;
  }

  .chx-txhero__cta-compare {
    opacity: 0.6;
  }

  .chx-txhero__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-txhero__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-heading);
    font-size: var(--font-size-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .chx-txhero__badge--muted {
    color: var(--text-muted);
  }

  .chx-txhero__badge-icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--text-heading);
  }

  .chx-txhero__badge-icon svg {
    width: 100%;
    height: 100%;
  }

  .chx-txhero .chx-txhero__details {
    margin-top: var(--space-2);
  }

  .chx-txhero .chx-txhero__details:not(:has(.chx-faq__item)) {
    display: none;
  }

  @media (max-width: 1024px) {
    .chx-txhero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .chx-txhero__media {
      aspect-ratio: 4 / 3;
    }

    .chx-txhero__content {
      padding: var(--space-10) var(--section-px) var(--space-16);
    }

    .chx-txhero__inner {
      max-width: 720px;
      margin-inline: auto;
    }
  }

  @media (max-width: 767px) {
    .chx-txhero__media {
      aspect-ratio: 1 / 1;
    }

    .chx-txhero__content {
      padding-top: var(--space-8);
      padding-bottom: var(--space-10);
    }

    .chx-txhero__inner {
      gap: var(--space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment hero",
  "tag": "section",
  "class": "chopinrx-tx-hero-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Eyebrow, summary, course length and the accordions come from the product's custom fields (Goal, Summary, Course length, Detail rows). The button links to the product's MyDose intake."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Defaults to the product's featured image."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow fallback",
      "default": "Treatment"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Get started"
    },
    {
      "type": "text",
      "id": "soon_label",
      "label": "Button label without intake link",
      "default": "Coming soon"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "default": "/mo"
    },
    {
      "type": "text",
      "id": "compare_label",
      "label": "Compare-at price label (screen readers)",
      "default": "Regular price"
    },
    {
      "type": "text",
      "id": "course_label",
      "label": "Course length label",
      "default": "Course:"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "Vial · placeholder"
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Third-party lab tested"
        }
      ]
    },
    {
      "type": "detail",
      "name": "Accordion row",
      "settings": [
        {
          "type": "paragraph",
          "content": "Only used when the product has no Detail rows custom field. [product] is replaced by the product name."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "What is [product]?"
        },
        {
          "type": "select",
          "id": "source",
          "label": "Content",
          "options": [
            { "value": "description", "label": "Product description" },
            { "value": "custom", "label": "Custom text" }
          ],
          "default": "description"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Custom text"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment hero",
      "blocks": [{ "type": "badge" }, { "type": "detail" }]
    }
  ]
}
{% endschema %}
