{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign check_icon = 'icon-tx-check-box.svg' | inline_asset_content
  assign x_icon = 'icon-tx-x-box.svg' | inline_asset_content
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title
  assign rows = section.blocks | where: 'type', 'row'

  assign variant = product.selected_or_first_available_variant
  assign intake_url = variant.metafields.custom.mydos_link.value | default: product.metafields.custom.mydos_link.value | default: '' | strip
  if product.tags contains 'coming-soon'
    assign intake_url = ''
  endif
%}

{%- if rows.size > 0 -%}
  <div class="chx-tx chx-txcompare" data-chx-reveal-root>
    <div class="chx-container chx-txcompare__inner">
      {%- if eyebrow != blank or heading != blank -%}
        <header class="chx-txcompare__header">
          {%- if eyebrow != blank -%}
            <p class="chx-txlabel">{{ eyebrow }}</p>
          {%- endif -%}
          {%- if heading != blank -%}
            <h2 class="chx-txtitle">{{ heading }}</h2>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="chx-txcompare__grid">
        {%- for side in (1..2) -%}
          {%- liquid
            if side == 1
              assign col_image = section.settings.us_image
              assign col_title = section.settings.us_label
              assign col_icon = check_icon
              assign col_class = 'us'
            else
              assign col_image = section.settings.them_image
              assign col_title = section.settings.them_label
              assign col_icon = x_icon
              assign col_class = 'them'
            endif
          -%}
          <div class="chx-txcompare__col chx-txcompare__col--{{ col_class }}">
            {%- if col_image != blank -%}
              {{
                col_image
                | image_url: width: 1400
                | image_tag:
                  widths: '500, 800, 1100, 1400',
                  sizes: '(max-width: 767px) 100vw, 50vw',
                  loading: 'lazy',
                  class: 'chx-txcompare__image',
                  alt: ''
              }}
            {%- endif -%}
            <h3 class="chx-txcompare__col-title">{{ col_title }}</h3>
            <ul class="chx-txcompare__panel" role="list">
              {%- for block in rows -%}
                {%- if side == 1 -%}
                  {%- assign text = block.settings.us -%}
                {%- else -%}
                  {%- assign text = block.settings.them -%}
                {%- endif -%}
                {%- if text != blank -%}
                  <li class="chx-txcompare__item" data-chx-reveal {% if side == 1 %}{{ block.shopify_attributes }}{% endif %}>
                    <span class="chx-txcompare__icon" aria-hidden="true">{{ col_icon }}</span>
                    <span>{{ text }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endfor -%}
      </div>

      {%- if section.settings.note != blank or section.settings.cta_label != blank and intake_url != blank -%}
        <div class="chx-txcompare__footer">
          {%- if section.settings.cta_label != blank and intake_url != blank -%}
            <a class="chx-txbtn" href="{{ intake_url }}">{{ section.settings.cta_label }}</a>
          {%- endif -%}
          {%- if section.settings.note != blank -%}
            <p class="chx-txcompare__note">{{ section.settings.note }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
<script src="{{ 'chopinrx-tx-reveal.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% stylesheet %}
  .chx-txcompare {
    /* No bottom padding: the next section's top padding is the gap. */
    padding-block: var(--space-6) 0;
    background: var(--surface-card);
  }

  .chx-txcompare__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .chx-txcompare__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-3);
    text-align: center;
  }

  .chx-txcompare__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .chx-txcompare__col {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-10);
    min-height: 720px;
    padding: var(--space-10) var(--space-6) var(--space-16);
    overflow: hidden;
    color: var(--text-on-dark);
    text-align: center;
  }

  .chx-txcompare__col--us {
    background: var(--surface-dark);
  }

  .chx-txcompare__col--them {
    background: #2b2f33;
  }

  .chx-txcompare .chx-txcompare__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-txcompare__col--them .chx-txcompare__image {
    filter: grayscale(1);
  }

  /* Keeps the white column title legible over a bright photo. */
  .chx-txcompare__col::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 200px;
    background: linear-gradient(180deg, rgb(13 37 53 / 70%) 0%, rgb(13 37 53 / 0%) 100%);
    pointer-events: none;
  }

  .chx-txcompare .chx-txcompare__col-title,
  .chx-txcompare .chx-txcompare__panel {
    z-index: 1;
  }

  .chx-txcompare .chx-txcompare__col-title {
    position: relative;
    margin: 0;
    color: var(--text-on-dark);
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .chx-txcompare__panel {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    width: 100%;
    max-width: 440px;
    margin: auto 0;
    padding: var(--space-8) var(--space-6);
    background: rgb(13 37 53 / 62%);
    backdrop-filter: blur(4px);
    list-style: none;
  }

  .chx-txcompare__col--them .chx-txcompare__panel {
    background: rgb(30 30 30 / 62%);
  }

  .chx-txcompare__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-body);
    line-height: 1.4;
  }

  .chx-txcompare__icon {
    display: inline-flex;
    width: 16px;
    height: 16px;
    color: var(--text-on-dark);
  }

  .chx-txcompare__icon svg {
    width: 100%;
    height: 100%;
  }

  .chx-txcompare__footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-4);
    text-align: center;
  }

  .chx-txcompare__note {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-caption);
  }

  @media (max-width: 1024px) {
    .chx-txcompare__col {
      min-height: 620px;
    }

    .chx-txcompare__item {
      font-size: var(--font-size-body-small);
    }
  }

  @media (max-width: 767px) {
    .chx-txcompare__grid {
      grid-template-columns: 1fr;
    }

    .chx-txcompare__col {
      gap: var(--space-6);
      min-height: 0;
      padding: var(--space-8) var(--space-4);
    }

    .chx-txcompare__panel {
      padding: var(--space-6) var(--space-4);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment comparison",
  "tag": "section",
  "class": "chopinrx-tx-compare-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "image_picker",
      "id": "us_image",
      "label": "Our column image"
    },
    {
      "type": "text",
      "id": "us_label",
      "label": "Our column title",
      "default": "Chopin Wellness"
    },
    {
      "type": "image_picker",
      "id": "them_image",
      "label": "Other column image",
      "info": "Shown in black and white."
    },
    {
      "type": "text",
      "id": "them_label",
      "label": "Other column title",
      "default": "Clinics, med spas and online vendors"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Optional. Links to the product's MyDose intake and hides without one."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note",
      "default": "You're only charged after a provider approves your prescription."
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        {
          "type": "text",
          "id": "us",
          "label": "Chopin Wellness",
          "default": "A licensed provider reviews every plan"
        },
        {
          "type": "text",
          "id": "them",
          "label": "Others",
          "default": "No medical review before you buy"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment comparison",
      "blocks": [{ "type": "row" }, { "type": "row" }, { "type": "row" }]
    }
  ]
}
{% endschema %}
