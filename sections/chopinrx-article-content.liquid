{% render 'chopinrx-tokens' %}

<div class="chx-articlebody">
  <div class="chx-container">
    <div class="chx-measure chx-articlebody__measure">
      {%- if article.image != blank and section.settings.show_image -%}
        <div class="chx-articlebody__media">
          <img
            src="{{ article.image | image_url: width: 1600 }}"
            srcset="
              {{ article.image | image_url: width: 750 }} 750w,
              {{ article.image | image_url: width: 1100 }} 1100w,
              {{ article.image | image_url: width: 1600 }} 1600w
            "
            sizes="(min-width: 1025px) 1202px, 100vw"
            width="{{ article.image.width }}"
            height="{{ article.image.height }}"
            alt="{{ article.image.alt | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        </div>
      {%- endif -%}

      <div class="chx-richtext">{{ article.content }}</div>

      {%- if section.settings.show_comments and blog.comments_enabled? -%}
        <div class="chx-richtext chx-articlebody__comments">
          <h2>{{ 'blogs.article.comments_heading' | t: count: article.comments_count }}</h2>
          {%- for comment in article.comments -%}
            <p>
              <strong>{{ comment.author }}</strong><br>
              {{ comment.content }}
            </p>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .chx-articlebody {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
  }

  .chx-articlebody__measure {
    gap: var(--space-16);
  }

  .chx-articlebody__media {
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--surface-well);
    aspect-ratio: 1202 / 400;
  }

  .chx-articlebody__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ── Article copy ─────────────────────────────
     The rich text comes from the article editor, so the rhythm is set on the
     elements rather than on wrappers. */
  .chx-richtext {
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--text-body);
  }

  .chx-richtext > :first-child {
    margin-block-start: 0;
  }

  .chx-richtext > :last-child {
    margin-block-end: 0;
  }

  .chx-richtext h1,
  .chx-richtext h2 {
    margin-block: var(--space-10) 30px;
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
    color: var(--text-heading);
  }

  .chx-richtext h3,
  .chx-richtext h4 {
    margin-block: 30px var(--space-4);
    font-family: var(--font-display);
    font-size: var(--font-size-h5);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-heading);
  }

  .chx-richtext p {
    margin-block: 0 var(--space-4);
    font-size: inherit;
    line-height: inherit;
  }

  .chx-richtext ul,
  .chx-richtext ol {
    margin-block: 0 var(--space-4);
    padding-inline-start: 27px;
  }

  .chx-richtext li + li {
    margin-block-start: var(--space-3);
  }

  .chx-richtext a {
    color: var(--text-heading);
    text-decoration: underline;
  }

  .chx-richtext a:hover {
    color: var(--text-accent);
  }

  .chx-richtext strong {
    font-weight: 600;
  }

  .chx-richtext img {
    display: block;
    width: 100%;
    height: auto;
    margin-block: var(--space-10);
    border-radius: var(--radius-lg);
  }

  .chx-richtext blockquote {
    margin: var(--space-10) 0;
    padding-inline-start: var(--space-6);
    border-inline-start: 2px solid var(--surface-accent);
    font-family: var(--font-display);
    font-size: var(--font-size-h5);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--text-heading);
  }

  .chx-articlebody__comments {
    padding-block-start: var(--space-10);
    border-block-start: var(--border-w) solid var(--border-hairline);
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 767px) {
    .chx-articlebody {
      padding-block: var(--space-10);
    }

    .chx-articlebody__media {
      aspect-ratio: 359 / 240;
    }

    .chx-richtext {
      font-size: var(--font-size-body);
      line-height: 1.5;
    }

    .chx-richtext h1,
    .chx-richtext h2 {
      font-size: var(--font-size-h4);
      line-height: 1.12;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article content",
  "tag": "section",
  "class": "chopinrx-article-content-section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_comments",
      "label": "Show comments",
      "default": false
    }
  ]
}
{% endschema %}
