{% render 'chopinrx-tokens' %}

{%- liquid
  # Blocks are flat: a "goal" block opens a row and the "pick" blocks after it
  # fill that row with cards. The first pick of each row is the recommended one.
  assign heading_id = section.id | append: '-heading'
-%}

<section
  class="chx-goals"
  id="{{ section.settings.anchor | default: 'shop-by-goal' | handleize }}"
  aria-labelledby="{{ heading_id }}"
>
  <div class="chx-container">
    {% render 'chopinrx-split-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      body: section.settings.body,
      heading_id: heading_id
    %}

    <div class="chx-goals__rows">
      {%- for goal in section.blocks -%}
        {%- if goal.type != 'goal' -%}
          {%- continue -%}
        {%- endif -%}
        {%- liquid
          assign first_pick = forloop.index
          assign pick_index = 0
        -%}
        <div class="chx-goals__row" {{ goal.shopify_attributes }}>
          <div class="chx-goals__goal">
            <h3 class="chx-h5 chx-goals__goal-title">{{ goal.settings.title }}</h3>
            {%- if goal.settings.subtitle != blank -%}
              <p class="chx-goals__goal-text">{{ goal.settings.subtitle }}</p>
            {%- endif -%}
          </div>
          <div class="chx-goals__cards">
            {%- for block in section.blocks offset: first_pick -%}
              {%- if block.type == 'goal' -%}
                {%- break -%}
              {%- endif -%}
              {%- liquid
                assign item = block.settings.product
                if item == blank
                  continue
                endif
                assign pick_index = pick_index | plus: 1

                # A pick can point at one form of the product, e.g. the patch.
                assign variant = item.selected_or_first_available_variant
                if block.settings.variant_form != blank
                  for v in item.variants
                    if v.option1 == block.settings.variant_form
                      assign variant = v
                      break
                    endif
                  endfor
                  assign amount = variant.price
                else
                  assign amount = item.price_min
                endif

                assign name = block.settings.name | default: item.title
                assign subtitle = block.settings.subtitle | default: item.metafields.custom.subtitle.value
                assign form = block.settings.form | default: item.metafields.custom.form_label.value | default: variant.option1
                assign intake_url = item.metafields.custom.mydos_link.value | default: '#'
              -%}
              <article class="chx-goal-card{% if pick_index == 1 %} chx-goal-card--featured{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}
                  <p class="chx-goal-card__label">{{ block.settings.label }}</p>
                {%- endif -%}
                <h4 class="chx-goal-card__name">{{ name }}</h4>
                {%- if subtitle != blank -%}
                  <p class="chx-goal-card__sub">{{ subtitle }}</p>
                {%- endif -%}
                <p class="chx-goal-card__meta">
                  {{- form -}}
                  {%- if section.settings.intake_note != blank %} · {{ section.settings.intake_note }}{% endif -%}
                </p>
                <div class="chx-goal-card__foot">
                  {% render 'chopinrx-price-from',
                    amount: amount,
                    prefix: section.settings.price_prefix,
                    unit: section.settings.price_unit
                  %}
                  <a
                    class="chx-btn chx-btn--sm {% if pick_index == 1 %}chx-btn--accent{% else %}chx-btn--secondary{% endif %}"
                    href="{{ intake_url }}"
                    aria-label="{{ section.settings.cta_label | escape }}: {{ name | escape }}"
                  >
                    {{- section.settings.cta_label -}}
                  </a>
                </div>
              </article>
            {%- endfor -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.footnote != blank -%}
      <p class="chx-goals__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .chx-goals {
    padding-block: var(--section-py-tight);
    background-color: var(--surface-page);
    scroll-margin-top: calc(var(--header-height, 84px) + var(--space-4));
  }

  .chx-goals__rows {
    margin-block-start: var(--space-8);
    border-top: var(--border-w) solid var(--border-hairline);
  }

  .chx-goals__row {
    display: grid;
    grid-template-columns: 270px minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-6);
    border-bottom: var(--border-w) solid var(--border-hairline);
  }

  .chx-goals__row:last-child {
    border-bottom: 0;
  }

  .chx-goals__goal {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .chx-goals .chx-goals__goal-title {
    font-weight: 600;
  }

  .chx-goals__goal-text {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    line-height: 1.43;
    color: var(--text-muted);
  }

  .chx-goals__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-4);
  }

  .chx-goal-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-5);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
  }

  .chx-goal-card--featured {
    border: 2px solid var(--ink-900);
    padding: calc(var(--space-5) - 1px);
  }

  .chx-goal-card__label {
    margin: 0 0 var(--space-3);
    font-family: var(--font-ui);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .chx-goal-card--featured .chx-goal-card__label {
    color: var(--text-accent);
  }

  .chx-goal-card__name {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-body-large);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.01em;
    color: var(--text-heading);
  }

  .chx-goal-card__sub {
    margin: var(--space-2) 0 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    line-height: 1.43;
    color: var(--text-muted);
  }

  .chx-goal-card__meta {
    margin: var(--space-3) 0 0;
    font-family: var(--font-ui);
    font-size: 13px;
    line-height: 1.4;
    color: var(--text-body);
  }

  .chx-goal-card__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: auto;
    padding-block-start: var(--space-5);
  }

  .chx-goal-card__foot .chx-price-from {
    font-size: var(--font-size-body-large);
  }

  .chx-goals__footnote {
    margin: var(--space-6) 0 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    line-height: 1.43;
    color: var(--text-muted);
  }

  @media screen and (max-width: 1024px) {
    .chx-goals__row {
      grid-template-columns: minmax(0, 1fr);
    }

    .chx-goals__cards {
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .chx-goals__cards {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by goal",
  "tag": "div",
  "class": "chopinrx-goals-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "shop-by-goal"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shop by goal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Not sure where to start?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "Footnote"
    },
    {
      "type": "header",
      "content": "Cards"
    },
    {
      "type": "text",
      "id": "intake_note",
      "label": "Intake note",
      "default": "1 intake"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "default": "/mo"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Links to the product's Mydos Link field.",
      "default": "Start intake"
    }
  ],
  "blocks": [
    {
      "type": "goal",
      "name": "Goal",
      "settings": [
        {
          "type": "paragraph",
          "content": "Starts a row. The pick blocks after it become its cards; the first one is highlighted."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Lose weight"
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle"
        }
      ]
    },
    {
      "type": "pick",
      "name": "Pick",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Recommended start"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "info": "Defaults to the product title."
        },
        {
          "type": "text",
          "id": "subtitle",
          "label": "Subtitle",
          "info": "Defaults to the product's Subtitle field."
        },
        {
          "type": "text",
          "id": "form",
          "label": "Form",
          "info": "Defaults to the product's Form label field."
        },
        {
          "type": "text",
          "id": "variant_form",
          "label": "Price from form",
          "info": "Optional. Uses the price of this form variant, e.g. Patch."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by goal"
    }
  ]
}
{% endschema %}
