{% render 'chopinrx-tokens' %}

{% liquid
  assign image = section.settings.image
  assign slash_icon = 'icon-breadcrumb-slash.svg' | inline_asset_content
%}

<div class="chx-abouthero">
  <div class="chx-abouthero__frame">
    {%- if image != blank -%}
      <img
        class="chx-abouthero__media"
        src="{{ image | image_url: width: 1920 }}"
        srcset="
          {{ image | image_url: width: 750 }} 750w,
          {{ image | image_url: width: 1100 }} 1100w,
          {{ image | image_url: width: 1500 }} 1500w,
          {{ image | image_url: width: 1920 }} 1920w,
          {{ image | image_url: width: 2560 }} 2560w
        "
        sizes="100vw"
        width="{{ image.width }}"
        height="{{ image.height }}"
        alt="{{ image.alt | escape }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    <nav class="chx-breadcrumbs" aria-label="Breadcrumb">
      <ol class="chx-breadcrumbs__list" role="list">
        <li class="chx-breadcrumbs__item">
          <a class="chx-breadcrumbs__link" href="{{ routes.root_url }}">
            {{- section.settings.breadcrumb_home -}}
          </a>
        </li>
        <li class="chx-breadcrumbs__item">
          <span class="chx-breadcrumbs__sep" aria-hidden="true">{{ slash_icon }}</span>
          <span class="chx-breadcrumbs__current" aria-current="page">
            {{- section.settings.breadcrumb_current | default: page.title -}}
          </span>
        </li>
      </ol>
    </nav>

    <div class="chx-abouthero__content">
      {%- if section.settings.heading != blank -%}
        <h1 class="chx-h2 chx-abouthero__title">{{ section.settings.heading }}</h1>
      {%- endif -%}

      {%- if section.settings.body != blank -%}
        <div class="chx-body-lg chx-abouthero__text">{{ section.settings.body }}</div>
      {%- endif -%}

      {%- if section.settings.show_trustpilot -%}
        {% render 'chopinrx-trustpilot',
          variant: 'about',
          rating: section.settings.trustpilot_rating,
          score: section.settings.trustpilot_score,
          count: section.settings.trustpilot_count,
          mobile_count: section.settings.trustpilot_mobile_count,
          url: section.settings.trustpilot_url
        %}
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .chx-abouthero {
    background-color: var(--surface-page);
    padding-inline: 17px;
  }

  .chx-abouthero__frame {
    --chx-heading-color: var(--text-on-dark);
    --chx-body-color: var(--text-on-dark);

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    min-height: 600px;
    padding: 80px var(--section-px);
    border-radius: var(--radius-xl);
    overflow: clip;
    background-color: var(--surface-dark);
    color: var(--text-on-dark);
  }

  /* The photograph sits under the ink surface at 30%, as drawn. */
  .chx-abouthero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.3;
  }

  .chx-abouthero__content {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-6);
    width: 100%;
    max-width: 978px;
    text-align: center;
  }

  .chx-abouthero__title {
    color: var(--text-on-dark);
  }

  .chx-abouthero__text {
    color: var(--text-on-dark);
  }

  .chx-abouthero__text > :first-child {
    margin-block-start: 0;
  }

  .chx-abouthero__text > :last-child {
    margin-block-end: 0;
  }

  /* ── Breadcrumbs ────────────────────────────── */
  .chx-breadcrumbs {
    position: relative;
  }

  .chx-breadcrumbs__list {
    display: flex;
    align-items: center;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-breadcrumbs__item {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .chx-breadcrumbs__link,
  .chx-breadcrumbs__current {
    font-family: var(--font-ui);
    font-size: var(--font-size-button);
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.005em;
    color: #89939e;
    text-decoration: none;
  }

  .chx-breadcrumbs__link:hover {
    color: var(--text-on-dark);
    text-decoration: none;
  }

  .chx-breadcrumbs__sep {
    display: block;
    flex-shrink: 0;
    width: 12px;
    height: 20px;
  }

  .chx-breadcrumbs__sep svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-abouthero__frame {
      min-height: 520px;
      padding-block: var(--space-16);
    }
  }

  @media screen and (max-width: 767px) {
    .chx-abouthero {
      padding-inline: 0;
    }

    .chx-abouthero__frame {
      min-height: 512px;
      padding: 80px 17px;
    }

    .chx-breadcrumbs__link,
    .chx-breadcrumbs__current {
      font-size: var(--font-size-body-small);
      line-height: 1.43;
    }

    /* Rich text renders a <p> the theme sizes itself, so the size has to be set
       on it rather than inherited from the wrapper. */
    .chx-abouthero__text,
    .chx-abouthero__text p {
      font-size: var(--font-size-body);
      line-height: 1.5;
    }

    /* The strip stands 32px off the copy on mobile, 24px on desktop. */
    .chx-abouthero__content .chx-trustpilot {
      margin-block-start: var(--space-2);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "class": "chopinrx-about-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Upload to Content → Files, then pick it here."
    },
    {
      "type": "text",
      "id": "breadcrumb_home",
      "label": "Breadcrumb: home label",
      "default": "Home"
    },
    {
      "type": "text",
      "id": "breadcrumb_current",
      "label": "Breadcrumb: current label",
      "info": "Defaults to the page title.",
      "default": "About us"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A platform built around the patient, not the system."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>ChopinRX exists to make provider-guided telehealth care more accessible, more transparent, and more personal — without the complexity of traditional healthcare.</p>"
    },
    {
      "type": "header",
      "content": "Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot strip",
      "default": true
    },
    {
      "type": "text",
      "id": "trustpilot_rating",
      "label": "Rating word",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "trustpilot_score",
      "label": "Score",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "trustpilot_count",
      "label": "Review count (desktop)",
      "default": "436 reviews"
    },
    {
      "type": "text",
      "id": "trustpilot_mobile_count",
      "label": "Review line (mobile)",
      "default": "Check out our 436 reviews"
    },
    {
      "type": "url",
      "id": "trustpilot_url",
      "label": "Trustpilot link"
    }
  ],
  "presets": [
    {
      "name": "About hero"
    }
  ]
}
{% endschema %}
