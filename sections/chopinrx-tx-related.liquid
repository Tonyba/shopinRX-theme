{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign chevron_left = 'icon-chevron-left.svg' | inline_asset_content
  assign chevron_right = 'icon-chevron-right.svg' | inline_asset_content
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title
  assign limit = section.settings.products_count

  # Source: the picked collection, else the product's goal collection (its
  # first collection that is not a catalogue root such as program/treatment).
  assign source = section.settings.collection
  if source == blank
    assign type_handles = section.settings.type_collections | downcase | replace: ' ', '' | split: ','
    for c in product.collections
      unless type_handles contains c.handle
        assign source = c
        break
      endunless
    endfor
  endif
  if source == blank
    assign source = product.collections.first
  endif

  assign shown = 0
  if source != blank
    for p in source.products limit: 20
      if p.id != product.id and p.available
        assign shown = shown | plus: 1
      endif
    endfor
  endif
  if shown > limit
    assign shown = limit
  endif
%}

{%- if shown > 0 -%}
  <div class="chx-tx chx-txrelated" data-chx-carousel>
    <div class="chx-container chx-txrelated__inner">
      <header class="chx-txrelated__header">
        {%- if eyebrow != blank -%}
          <p class="chx-txlabel">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="chx-txtitle">{{ heading }}</h2>
        {%- endif -%}
      </header>

      <div class="chx-txrelated__viewport" data-chx-carousel-viewport>
        <ul class="chx-txrelated__track" role="list">
          {%- assign count = 0 -%}
          {%- for p in source.products limit: 20 -%}
            {%- if p.id == product.id or p.available == false -%}{%- continue -%}{%- endif -%}
            {%- if count >= limit -%}{%- break -%}{%- endif -%}
            {%- assign count = count | plus: 1 -%}
            <li class="chx-txrelated__slide">
              <a class="chx-txrelated__card" href="{{ p.url }}">
                <div class="chx-txrelated__media">
                  {%- if p.featured_media -%}
                    {{
                      p.featured_media.preview_image
                      | image_url: width: 800
                      | image_tag:
                        widths: '300, 500, 800',
                        sizes: '(max-width: 767px) 80vw, (max-width: 1024px) 45vw, 25vw',
                        loading: 'lazy',
                        alt: p.featured_media.alt | default: p.title
                    }}
                  {%- endif -%}
                </div>
                <p class="chx-txrelated__meta">
                  <span class="chx-txrelated__name">{{ p.title }}</span>
                  <span class="chx-txrelated__price">
                    {{- section.settings.price_prefix }}
                    {{ p.price_min | money_without_trailing_zeros -}}
                    {{- section.settings.price_unit -}}
                  </span>
                </p>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </div>

      {%- if shown > 1 -%}
        <div class="chx-txarrows">
          <button type="button" class="chx-txarrows__button" aria-label="{{ 'content.pagination.previous' | t }}" data-chx-carousel-prev>
            <span aria-hidden="true">{{ chevron_left }}</span>
          </button>
          <button type="button" class="chx-txarrows__button" aria-label="{{ 'content.pagination.next' | t }}" data-chx-carousel-next>
            <span aria-hidden="true">{{ chevron_right }}</span>
          </button>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if shown > 1 -%}
    <script type="module">
      import EmblaCarousel from '{{ 'embla-carousel.js' | asset_url }}';
      import { initCarousels } from '{{ 'chopinrx-carousel.js' | asset_url }}';
      initCarousels(EmblaCarousel);
    </script>
  {%- endif -%}
{%- endif -%}

{% stylesheet %}
  .chx-txrelated {
    padding-block: var(--space-24);
    overflow: hidden;
    background: var(--surface-muted);
  }

  .chx-txrelated__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .chx-txrelated__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chx-txrelated__viewport {
    overflow: visible;
  }

  .chx-txrelated__track {
    display: flex;
    margin: 0 calc(var(--space-2) * -1);
    padding: 0;
    list-style: none;
    touch-action: pan-y pinch-zoom;
  }

  .chx-txrelated__slide {
    flex: 0 0 25%;
    min-width: 0;
    padding-inline: var(--space-2);
  }

  .chx-txrelated__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: inherit;
    text-decoration: none;
  }

  .chx-txrelated__card:focus-visible {
    outline: 2px solid var(--accent-500);
    outline-offset: 3px;
  }

  .chx-txrelated__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--surface-well);
  }

  .chx-txrelated__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .chx-txrelated__card:hover .chx-txrelated__media img {
    transform: scale(1.03);
  }

  .chx-txrelated__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-1) var(--space-2);
    margin: 0;
  }

  .chx-txrelated__name {
    color: var(--text-heading);
    font-size: var(--font-size-body);
    font-weight: 600;
  }

  .chx-txrelated__price {
    color: var(--text-muted);
    font-size: var(--font-size-body-small);
  }

  @media (max-width: 1024px) {
    .chx-txrelated {
      padding-block: var(--space-16);
    }

    .chx-txrelated__slide {
      flex-basis: 45%;
    }
  }

  @media (max-width: 767px) {
    .chx-txrelated {
      padding-block: var(--space-10);
    }

    .chx-txrelated__inner {
      gap: var(--space-6);
    }

    .chx-txrelated__slide {
      flex-basis: 80%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment related",
  "tag": "section",
  "class": "chopinrx-tx-related-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "05 / More for you"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Related treatments"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to use the product's goal collection."
    },
    {
      "type": "text",
      "id": "type_collections",
      "label": "Catalogue collections to skip",
      "info": "Comma-separated handles that are not goals.",
      "default": "program, treatment"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "default": "/mo"
    }
  ],
  "presets": [
    {
      "name": "Treatment related"
    }
  ]
}
{% endschema %}
