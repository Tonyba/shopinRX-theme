{% render 'chopinrx-tokens' %}

<div class="chx-mission">
  <div class="chx-container">
    <div class="chx-mission__copy">
      {% render 'chopinrx-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        class: 'chx-mission__heading'
      %}

      {%- if section.settings.body != blank -%}
        <div class="chx-body-lg chx-mission__body">{{ section.settings.body }}</div>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .chx-mission {
    background-color: var(--surface-card-flat);
    padding-block: var(--section-py-tight);
  }

  .chx-mission__copy {
    /* Muted copy through the inherited property, so the shared body primitive
       follows without an equal-specificity contest. */
    --chx-body-color: var(--text-muted);

    display: flex;
    flex-direction: column;
    gap: 30px;
  }

  .chx-mission__heading {
    align-items: center;
    text-align: center;
  }

  .chx-mission__body {
    text-align: center;
  }

  .chx-mission__body > :first-child {
    margin-block-start: 0;
  }

  .chx-mission__body > :last-child {
    margin-block-end: 0;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 767px) {
    .chx-mission {
      padding-block: var(--space-10);
    }

    /* Rich text renders a <p> the theme sizes itself, so the size has to be set
       on it rather than inherited from the wrapper. */
    .chx-mission__body,
    .chx-mission__body p {
      font-size: var(--font-size-body);
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About mission",
  "tag": "section",
  "class": "chopinrx-about-mission-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Mission Statement"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text is rendered in the accent colour.",
      "default": "Our <em>Mission</em> Statement"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Managing prescriptions isn’t always easy, but at ChopinRX, we are constantly working to make it as uncomplicated and trouble-free as possible. We aim to build a world where everyone has easy access to high-quality healthcare services, whenever and wherever they need it.</p>"
    }
  ],
  "presets": [
    {
      "name": "About mission"
    }
  ]
}
{% endschema %}
