{% render 'chopinrx-tokens' %}

{% liquid
  assign arrow_icon = 'icon-arrow-right.svg' | inline_asset_content | replace: '#FCFAF9', 'currentColor'
  assign collection = collections[section.settings.collection]
  assign unit = section.settings.price_unit
%}

<div class="chx-programs">
  <div class="chx-container">
    <div class="chx-programs__header">
      {% render 'chopinrx-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        class: 'chx-programs__heading'
      %}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="chx-btn chx-btn--secondary chx-programs__cta"
          href="{{ section.settings.cta_url | default: collection.url | default: routes.all_products_collection_url }}"
        >
          <span>{{ section.settings.cta_label }}</span>
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </a>
      {%- endif -%}
    </div>

    <ul class="chx-programs__grid" role="list">
      {%- for product in collection.products limit: section.settings.products_count -%}
        {%- liquid
          assign goal = product.metafields.custom.goal.value | default: product.type
          assign ingredients = product.metafields.custom.ingredients.value | join: ' · '

          assign product_tags = product.tags | join: ',' | downcase | split: ','
          assign badge_tag = section.settings.badge_tag | downcase
          assign badge = ''
          if badge_tag != blank and product_tags contains badge_tag
            assign badge = section.settings.badge_label
          endif

          assign summary = product.metafields.custom.summary.value
          if summary == blank
            assign summary = product.description | strip_html | truncatewords: 28
          endif
        -%}
        <li class="chx-program-card">
          {%- if badge != blank -%}
            <span class="chx-program-card__badge">{{ badge }}</span>
          {%- endif -%}

          <a class="chx-program-card__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
            {%- if product.featured_image -%}
              <img
                src="{{ product.featured_image | image_url: width: 900 }}"
                srcset="
                  {{ product.featured_image | image_url: width: 450 }} 450w,
                  {{ product.featured_image | image_url: width: 900 }} 900w,
                  {{ product.featured_image | image_url: width: 1200 }} 1200w
                "
                sizes="(min-width: 1025px) 33vw, (min-width: 768px) 50vw, 100vw"
                width="{{ product.featured_image.width }}"
                height="{{ product.featured_image.height }}"
                alt="{{ product.featured_image.alt | escape }}"
                loading="lazy"
              >
            {%- endif -%}
          </a>

          <div class="chx-program-card__content">
            <div class="chx-program-card__header">
              {%- if goal != blank -%}
                <span class="chx-pill chx-program-card__goal">{{ goal }}</span>
              {%- endif -%}

              <div class="chx-program-card__titles">
                <h3 class="chx-h3 chx-program-card__title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>
                {%- if ingredients != blank -%}
                  <p class="chx-program-card__ingredients">{{ ingredients }}</p>
                {%- endif -%}
              </div>
            </div>

            {%- if summary != blank -%}
              <p class="chx-program-card__text">{{ summary }}</p>
            {%- endif -%}

            <div class="chx-program-card__price">
              <span class="chx-program-card__price-current">
                <span class="chx-program-card__price-amount">
                  {%- if product.price_varies and section.settings.price_prefix != blank -%}
                    {{ section.settings.price_prefix }}&nbsp;
                  {%- endif -%}
                  {{- product.price | money_without_trailing_zeros -}}
                </span>
                {%- if unit != blank -%}
                  <span class="chx-program-card__price-unit">{{ unit }}</span>
                {%- endif -%}
              </span>
              {%- if product.compare_at_price > product.price -%}
                <s class="chx-program-card__price-compare">{{ product.compare_at_price | money_without_trailing_zeros }}{{ unit }}</s>
              {%- endif -%}
            </div>
          </div>

          <a class="chx-btn chx-btn--accent chx-program-card__cta" href="{{ product.url }}">
            <span>{{ section.settings.card_cta_label }}</span>
            <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
          </a>
        </li>
      {%- else -%}
        <li class="chx-programs__empty">{{ 'content.no_products_found' | t }}</li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  .chx-programs {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
  }

  .chx-programs__header {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }

  .chx-programs__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chx-programs__cta {
    flex-shrink: 0;
  }

  .chx-programs__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-5);
    margin: var(--space-10) 0 0;
    /* Room for the badge that overhangs the top edge of a featured card. */
    padding: var(--space-5) 0 0;
    list-style: none;
  }

  .chx-programs__empty {
    grid-column: 1 / -1;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    color: var(--text-muted);
  }

  /* ── Program card ───────────────────────────── */
  .chx-program-card {
    --chx-heading-color: var(--text-on-dark);
    --chx-body-color: var(--text-on-dark);

    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-6);
    padding: var(--space-8);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-dark);
    color: var(--text-on-dark);
  }

  .chx-program-card__badge {
    position: absolute;
    top: -13.5px;
    right: 19px;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 35px;
    padding-inline: 15px;
    border-radius: var(--radius-pill);
    background-color: var(--surface-accent);
    font-family: var(--font-ui);
    font-size: 17.5px;
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    color: var(--text-on-dark);
    white-space: nowrap;
  }

  .chx-program-card__media {
    display: block;
    width: 100%;
    aspect-ratio: 407 / 210;
    border-radius: var(--radius-md);
    overflow: clip;
    background-color: #d9d9d9;
  }

  .chx-program-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-program-card__content {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--space-6);
    width: 100%;
  }

  .chx-program-card__header {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .chx-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    align-self: flex-start;
    gap: var(--space-2);
    height: var(--pill-h);
    padding-inline: var(--space-3);
    border: var(--border-w) solid var(--text-accent);
    border-radius: var(--radius-pill);
    font-family: var(--font-ui);
    font-size: var(--font-size-label-tag);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.005em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .chx-program-card__titles {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .chx-program-card__title {
    color: var(--text-on-dark);
  }

  .chx-program-card__title a {
    color: inherit;
    text-decoration: none;
  }

  .chx-program-card__title a:hover {
    color: var(--text-accent);
    text-decoration: none;
  }

  .chx-program-card__ingredients {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-accent-strong);
  }

  .chx-program-card__text {
    flex: 1 1 auto;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-on-dark);
  }

  .chx-program-card__price {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .chx-program-card__price-current {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--text-on-dark);
  }

  .chx-program-card__price-amount {
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: 500;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  .chx-program-card__price-unit {
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.005em;
  }

  .chx-program-card__price-compare {
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--text-on-dark-muted);
  }

  .chx-program-card__cta {
    width: 100%;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-programs__header {
      gap: var(--space-8);
    }

    .chx-programs__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .chx-programs__header {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-6);
    }

    .chx-programs__cta {
      width: 100%;
    }

    .chx-programs__grid {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .chx-program-card {
      padding: var(--space-5);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Flagship programs",
  "tag": "section",
  "class": "chopinrx-programs-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Flagship Programs"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Start With A Flagship Program"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Varying price prefix",
      "info": "Shown before the price when a product has more than one price.",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "info": "Appended after the product price, e.g. /mo.",
      "default": "/mo"
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card button label",
      "default": "Start intake"
    },
    {
      "type": "paragraph",
      "content": "Goal pill reads custom.goal (falls back to the product type). Ingredients read custom.ingredients, a list of single line text, joined with a middot. Description reads custom.summary and falls back to the product description."
    },
    {
      "type": "text",
      "id": "badge_tag",
      "label": "Badge product tag",
      "info": "Products carrying this tag show the corner badge.",
      "default": "flagship"
    },
    {
      "type": "text",
      "id": "badge_label",
      "label": "Badge label",
      "default": "Flagship"
    },
    {
      "type": "header",
      "content": "Section button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See All Programs"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Flagship programs"
    }
  ]
}
{% endschema %}
