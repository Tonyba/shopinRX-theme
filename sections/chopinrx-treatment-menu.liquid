{% render 'chopinrx-tokens' %}

{%- liquid
  assign heading_id = section.id | append: '-heading'
  assign search_id = section.id | append: '-search'
-%}

<section
  class="chx-menu"
  id="{{ section.settings.anchor | default: 'full-menu' | handleize }}"
  aria-labelledby="{{ heading_id }}"
  data-chx-menu
>
  <div class="chx-container">
    {% render 'chopinrx-split-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      body: section.settings.body,
      heading_id: heading_id
    %}

    <form class="chx-menu__search" role="search" action="#">
      <label class="visually-hidden" for="{{ search_id }}">{{ section.settings.search_label }}</label>
      <span class="chx-menu__search-icon" aria-hidden="true">{{ 'icon-search.svg' | inline_asset_content }}</span>
      <input
        class="chx-menu__search-input"
        id="{{ search_id }}"
        type="search"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
        data-chx-menu-search
      >
    </form>

    <div class="chx-menu__chips" role="group" aria-label="{{ section.settings.chips_label | escape }}">
      <button type="button" class="chx-menu__chip" data-chx-menu-chip="all" aria-pressed="true">
        {{- section.settings.all_label -}}
      </button>
      {%- for block in section.blocks -%}
        {%- if block.settings.collection != blank -%}
          <button type="button" class="chx-menu__chip" data-chx-menu-chip="{{ block.id }}" aria-pressed="false">
            {{- block.settings.label | default: block.settings.collection.title -}}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="chx-menu__groups">
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection_ref = block.settings.collection
          if collection_ref == blank
            continue
          endif
          assign label = block.settings.label | default: collection_ref.title
          assign count_text = section.settings.count_label | replace: '[count]', collection_ref.products_count
        -%}
        <div class="chx-menu__group" data-chx-menu-group="{{ block.id }}" {{ block.shopify_attributes }}>
          <div class="chx-menu__group-head">
            <h3 class="chx-menu__group-title">{{ label }}</h3>
            <p class="chx-menu__group-label" aria-hidden="true">{{ section.settings.options_label }}</p>
            <p class="chx-menu__group-count">{{ count_text }}</p>
          </div>
          <ul class="chx-menu__rows" role="list">
            {%- for item in collection_ref.products limit: 50 -%}
              {%- liquid
                assign subtitle = item.metafields.custom.subtitle.value
                assign actives = item.metafields.custom.ingredients.value | join: ' '
                assign forms = item.variants | map: 'option1' | uniq
                assign search_text = item.title | append: ' ' | append: subtitle | append: ' ' | append: actives | downcase | escape
                assign intake_url = item.metafields.custom.mydos_link.value
                if intake_url == blank
                  for variant in item.variants
                    if variant.metafields.custom.mydos_link.value != blank
                      assign intake_url = variant.metafields.custom.mydos_link.value
                      break
                    endif
                  endfor
                endif
                assign intake_url = intake_url | default: '#'
                assign row_id = section.id | append: '-' | append: block.id | append: '-' | append: item.id
                assign form_count = 0
                assign single_form = blank
                for form in forms
                  if form != 'Default Title'
                    assign form_count = form_count | plus: 1
                    assign single_form = form
                  endif
                endfor
                if form_count == 1
                  for variant in item.variants
                    if variant.option1 == single_form and variant.metafields.custom.mydos_link.value != blank
                      assign intake_url = variant.metafields.custom.mydos_link.value
                      break
                    endif
                  endfor
                endif
              -%}
              <li class="chx-menu__row" data-chx-menu-row data-chx-menu-text="{{ search_text }}">
                <div class="chx-menu__name-wrap">
                  <p class="chx-menu__name">
                    <span>{{ item.title }}{% if item.tags contains 'investigational' %}*{% endif %}</span>
                    {%- if item.tags contains 'protocol' -%}
                      <span class="chx-menu__badge">{{ section.settings.protocol_badge }}</span>
                    {%- elsif item.tags contains 'branded' -%}
                      <span class="chx-menu__badge chx-menu__badge--branded">{{ section.settings.branded_badge }}</span>
                    {%- endif -%}
                  </p>
                  {%- if subtitle != blank -%}
                    <p class="chx-menu__sub">{{ subtitle }}</p>
                  {%- endif -%}
                </div>
                {%- liquid
                  assign forms_text = ''
                  for form in forms
                    if form == 'Default Title'
                      continue
                    endif
                    if forms_text != ''
                      assign forms_text = forms_text | append: ' · '
                    endif
                    assign forms_text = forms_text | append: form
                  endfor
                -%}
                <p class="chx-menu__forms">
                  {%- if forms_text != '' -%}
                    <span class="visually-hidden">{{ section.settings.options_label }}: </span>{{ forms_text }}
                  {%- endif -%}
                </p>
                {% render 'chopinrx-price-from',
                  amount: item.price_min,
                  prefix: section.settings.price_prefix,
                  unit: section.settings.price_unit,
                  stack: true
                %}
                {%- if form_count > 1 -%}
                  {%- comment -%} Several forms: the button opens a list, each form opens its own intake. {%- endcomment -%}
                  <div class="chx-menu__pick" data-chx-menu-pick>
                    <button
                      type="button"
                      class="chx-btn chx-btn--sm chx-btn--secondary chx-menu__cta chx-menu__pick-toggle"
                      aria-expanded="false"
                      aria-controls="{{ row_id }}-pick"
                      aria-label="{{ section.settings.cta_label | escape }}: {{ item.title | escape }}"
                      data-chx-menu-pick-toggle
                    >
                      {{- section.settings.cta_label -}}
                      <span class="chx-menu__caret" aria-hidden="true"></span>
                    </button>
                    <div class="chx-menu__pick-panel" id="{{ row_id }}-pick" data-chx-menu-pick-panel hidden>
                      <p class="chx-menu__pick-label" id="{{ row_id }}-pick-label">{{ section.settings.pick_label }}</p>
                      <ul class="chx-menu__pick-list" role="list" aria-labelledby="{{ row_id }}-pick-label">
                        {%- for form in forms -%}
                          {%- if form == 'Default Title' -%}
                            {%- continue -%}
                          {%- endif -%}
                          {%- liquid
                            assign form_url = blank
                            for variant in item.variants
                              if variant.option1 == form and variant.metafields.custom.mydos_link.value != blank
                                assign form_url = variant.metafields.custom.mydos_link.value
                                break
                              endif
                            endfor
                            assign form_url = form_url | default: intake_url
                          -%}
                          <li>
                            <a
                              class="chx-menu__pick-option"
                              href="{{ form_url }}"
                              aria-label="{{ section.settings.cta_label | escape }}: {{ item.title | escape }}, {{ form | escape }}"
                            >
                              <span>{{ form }}</span>
                              <span class="chx-menu__pick-arrow" aria-hidden="true">&rarr;</span>
                            </a>
                          </li>
                        {%- endfor -%}
                      </ul>
                    </div>
                  </div>
                {%- else -%}
                  <a
                    class="chx-btn chx-btn--sm chx-btn--secondary chx-menu__cta"
                    href="{{ intake_url }}"
                    aria-label="{{ section.settings.cta_label | escape }}: {{ item.title | escape }}"
                  >
                    {{- section.settings.cta_label -}}
                  </a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endfor -%}

      <p class="chx-menu__empty" data-chx-menu-empty role="status" hidden>{{ section.settings.empty_text }}</p>
    </div>
  </div>
</section>

<script type="module">
  import { initMenuFilter, initMenuPick } from '{{ 'chopinrx-menu-filter.js' | asset_url }}';
  initMenuFilter();
  initMenuPick();
</script>

{% stylesheet %}
  .chx-menu {
    padding-block: var(--section-py-tight);
    background-color: var(--surface-card-flat);
    scroll-margin-top: calc(var(--header-height, 84px) + var(--space-4));
  }

  .chx-menu [hidden] {
    display: none;
  }

  .chx-menu__search {
    position: relative;
    margin-block-start: var(--space-8);
  }

  .chx-menu__search-icon {
    position: absolute;
    top: 50%;
    left: var(--space-5);
    width: 20px;
    height: 20px;
    color: var(--text-muted);
    transform: translateY(-50%);
    pointer-events: none;
    --icon-stroke-width: 1.5px;
  }

  .chx-menu__search-icon svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chx-menu__search-input {
    width: 100%;
    height: 54px;
    padding-inline: 52px var(--space-5);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--surface-card);
    font-family: var(--font-ui);
    font-size: 17px;
    color: var(--text-body);
    -webkit-appearance: none;
    appearance: none;
  }

  .chx-menu__search-input::placeholder {
    color: var(--text-muted);
  }

  .chx-menu__search-input:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .chx-menu__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-block-start: var(--space-4);
  }

  .chx-menu__chip {
    display: inline-flex;
    align-items: center;
    height: 44px;
    padding-inline: var(--space-4);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--surface-card);
    font-family: var(--font-ui);
    font-size: 15px;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--text-heading);
    cursor: pointer;
    transition: background-color 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .chx-menu__chip:hover {
    border-color: var(--border-strong);
  }

  .chx-menu__chip[aria-pressed='true'] {
    border-color: var(--ink-900);
    background-color: var(--ink-900);
    color: var(--text-on-dark);
  }

  .chx-menu__chip:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .chx-menu__groups {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    margin-block-start: var(--space-6);
  }

  /* Rows and the group head share one set of columns (subgrid), so the
     "Choose your option" label sits right above the option pills. */
  .chx-menu__group {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr) 110px auto;
    column-gap: var(--space-4);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
  }

  .chx-menu__group-head {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    padding: var(--space-6);
    border-bottom: var(--border-w) solid var(--border-hairline);
  }

  .chx-menu__group-label {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 500;
    color: var(--text-heading);
  }

  .chx-menu__group-count {
    grid-column: 3 / -1;
    justify-self: end;
  }

  .chx-menu__group-title {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-subtitle);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--text-heading);
  }

  .chx-menu__group-count {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    color: var(--text-muted);
  }

  .chx-menu__rows {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-menu__row {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-6);
    border-top: var(--border-w) solid var(--border-hairline);
  }

  .chx-menu__row:first-child {
    border-top: 0;
  }

  .chx-menu__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-heading);
  }

  .chx-menu__badge {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding-inline: 8px;
    border-radius: var(--radius-pill);
    background-color: var(--ink-900);
    font-size: 11px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-on-dark);
  }

  .chx-menu__badge--branded {
    background-color: var(--surface-info-soft);
    color: var(--text-info);
  }

  .chx-menu__sub {
    margin: 2px 0 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    line-height: 1.43;
    color: var(--text-muted);
  }

  .chx-menu__forms {
    min-width: 0;
    margin: 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.4;
    color: var(--text-body);
  }

  .chx-menu__pick {
    position: relative;
    justify-self: end;
  }

  .chx-menu .chx-menu__pick-toggle {
    gap: var(--space-2);
  }

  .chx-menu .chx-menu__pick-toggle[aria-expanded='true'] {
    border-color: var(--action-secondary-fg);
    background-color: var(--action-secondary-fg);
    color: var(--action-primary-fg);
  }

  .chx-menu__caret {
    width: 0;
    height: 0;
    border-inline: 3.5px solid transparent;
    border-top: 4px solid currentColor;
    transition: transform 0.2s ease;
  }

  .chx-menu__pick-toggle[aria-expanded='true'] .chx-menu__caret {
    transform: rotate(180deg);
  }

  .chx-menu__pick-panel {
    position: absolute;
    top: calc(100% + var(--space-3));
    right: 0;
    z-index: 5;
    width: 260px;
    padding: var(--space-4) 0 var(--space-2);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
    box-shadow: var(--shadow-popover);
  }

  .chx-menu__pick-label {
    margin: 0 0 4px;
    padding-inline: var(--space-5);
    font-family: var(--font-ui);
    font-size: 12px;
    line-height: 1.4;
    color: var(--text-muted);
  }

  .chx-menu__pick-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-menu .chx-menu__pick-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    min-height: 40px;
    padding-inline: var(--space-5);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.3;
    color: var(--text-heading);
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .chx-menu .chx-menu__pick-option:hover {
    background-color: var(--surface-card-flat);
  }

  .chx-menu .chx-menu__pick-option:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: -2px;
  }

  .chx-menu__pick-arrow {
    font-size: 18px;
    color: var(--text-muted);
  }

  .chx-menu__row .chx-price-from {
    font-size: 15px;
  }

  .chx-menu__empty {
    margin: 0;
    padding: var(--space-6);
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    color: var(--text-muted);
    text-align: center;
  }

  @media screen and (max-width: 767px) {
    .chx-menu__group,
    .chx-menu__rows {
      display: block;
    }

    .chx-menu__group-label {
      display: none;
    }

    .chx-menu__group-head {
      display: flex;
      justify-content: space-between;
      gap: var(--space-4);
      padding: var(--space-4);
    }

    .chx-menu__row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-3);
      padding: var(--space-4);
    }

    .chx-menu__name-wrap,
    .chx-menu__forms {
      grid-column: 1 / -1;
    }

    .chx-menu__forms:empty {
      display: none;
    }

    .chx-menu__row .chx-price-from--stack .chx-price-from__prefix {
      display: inline;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment menu",
  "tag": "div",
  "class": "chopinrx-menu-section",
  "settings": [
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor id",
      "default": "full-menu"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Full treatment menu"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Know what you want?"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Search and filters"
    },
    {
      "type": "text",
      "id": "search_label",
      "label": "Search label",
      "default": "Search treatments"
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Search treatments, e.g. tadalafil"
    },
    {
      "type": "text",
      "id": "chips_label",
      "label": "Category filter label",
      "default": "Filter by category"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "No results text",
      "default": "No treatments match your search."
    },
    {
      "type": "header",
      "content": "Rows"
    },
    {
      "type": "text",
      "id": "count_label",
      "label": "Count label",
      "info": "[count] is replaced with the number of treatments.",
      "default": "[count] treatments"
    },
    {
      "type": "text",
      "id": "protocol_badge",
      "label": "Protocol badge",
      "info": "Shown on products tagged protocol.",
      "default": "Protocol"
    },
    {
      "type": "text",
      "id": "branded_badge",
      "label": "Branded badge",
      "info": "Shown on products tagged branded.",
      "default": "Branded"
    },
    {
      "type": "text",
      "id": "options_label",
      "label": "Forms column label",
      "default": "Available as"
    },
    {
      "type": "text",
      "id": "pick_label",
      "label": "Form picker label",
      "info": "Shown in the Start intake menu on rows with several forms.",
      "default": "Choose your form"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "default": "/mo"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Rows with several forms open a menu to choose the form first.",
      "default": "Start intake"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "Defaults to the collection title."
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection",
          "info": "Rows follow the collection's sort order."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment menu"
    }
  ]
}
{% endschema %}
