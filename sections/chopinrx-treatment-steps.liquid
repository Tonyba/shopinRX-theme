{% render 'chopinrx-tokens' %}

{% liquid
  # On a product template the copy can name the product with [product].
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title

  # The steps come from the product's How it works custom field; the eyebrow
  # and heading settings are connected to its fields in the template. A
  # product with no heading hides the section.
  assign items = product.metafields.custom.how_steps.value
  assign hidden = false
  if template.name == 'product' and heading == blank
    assign hidden = true
  endif
%}

{%- unless hidden -%}

<div class="chx-tsteps">
  <div class="chx-container">
    {% render 'chopinrx-section-heading', eyebrow: eyebrow, heading: heading, centered: true %}

    {%- if items.size > 0 -%}
      <ol class="chx-tsteps__grid" role="list">
        {%- for item in items -%}
          {%- assign image = item.image.value -%}
          <li class="chx-tstep">
            <div class="chx-tstep__media">
              {%- if image != blank -%}
                <img
                  src="{{ image | image_url: width: 1000 }}"
                  srcset="
                    {{ image | image_url: width: 500 }} 500w,
                    {{ image | image_url: width: 750 }} 750w,
                    {{ image | image_url: width: 1000 }} 1000w
                  "
                  sizes="(max-width: 767px) 100vw, (max-width: 1024px) 33vw, 471px"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="chx-tstep__body">
              <h3 class="chx-tstep__title">
                <span class="chx-tstep__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="chx-tstep__rule" aria-hidden="true"></span>
                <span class="chx-tstep__label">{{ item.title.value }}</span>
              </h3>
              {%- if item.text.value != blank -%}
                <p class="chx-tstep__text">{{ item.text.value | newline_to_br }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- elsif section.blocks.size > 0 -%}
      <ol class="chx-tsteps__grid" role="list">
        {%- for block in section.blocks -%}
          {%- assign image = block.settings.image -%}
          <li class="chx-tstep" {{ block.shopify_attributes }}>
            <div class="chx-tstep__media">
              {%- if image != blank -%}
                <img
                  src="{{ image | image_url: width: 1000 }}"
                  srcset="
                    {{ image | image_url: width: 500 }} 500w,
                    {{ image | image_url: width: 750 }} 750w,
                    {{ image | image_url: width: 1000 }} 1000w
                  "
                  sizes="(max-width: 767px) 100vw, (max-width: 1024px) 33vw, 471px"
                  width="{{ image.width }}"
                  height="{{ image.height }}"
                  alt="{{ image.alt | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="chx-tstep__body">
              <h3 class="chx-tstep__title">
                <span class="chx-tstep__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="chx-tstep__rule" aria-hidden="true"></span>
                <span class="chx-tstep__label">{{ block.settings.title }}</span>
              </h3>
              {%- if block.settings.text != blank -%}
                <p class="chx-tstep__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</div>

{%- endunless -%}

{% stylesheet %}
  .chx-tsteps {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
    overflow: clip;
  }

  .chx-tsteps__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-10) 0 0;
    padding: 0;
    list-style: none;
  }

  .chx-tstep {
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-md);
    overflow: clip;
  }

  .chx-tstep__media {
    height: 325px;
    background-color: #d9d9d9;
  }

  .chx-tstep__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-tstep__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: 48px var(--space-6);
    background-color: var(--surface-card);
  }

  .chx-tstep__title {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--font-size-h4);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: var(--text-heading);
  }

  .chx-tstep__number {
    flex-shrink: 0;
    color: var(--text-accent);
  }

  .chx-tstep__rule {
    display: block;
    flex-shrink: 0;
    width: 17px;
    height: 3px;
    background-color: var(--text-accent);
  }

  .chx-tstep__label {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chx-tstep__text {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--text-body);
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-tstep__media {
      height: 260px;
    }

    .chx-tstep__body {
      padding: var(--space-8) var(--space-5);
    }
  }

  @media screen and (max-width: 767px) {
    .chx-tsteps {
      padding-block: var(--space-10);
    }

    .chx-tsteps__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
      margin-block-start: var(--space-8);
    }

    .chx-tstep__media {
      height: 195px;
    }

    .chx-tstep__body {
      padding: var(--space-6);
    }

    .chx-tstep__text {
      font-size: var(--font-size-body);
      line-height: 1.5;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment steps",
  "tag": "section",
  "class": "chopinrx-treatment-steps-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "On the product template the eyebrow and heading are connected to the product's How it works custom fields and the steps come from its How it works: steps field, falling back to the blocks below. A product without a heading hides the section."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "On a product page, [product] is replaced with the product title. Italic text is rendered in the accent colour.",
      "default": "How [product] works"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Upload to Content → Files, then pick it here."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Recovery Support"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "May support growth hormone secretion, cellular repair, and recovery processes as directed by an independent licensed provider."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Treatment steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "title": "Cellular Energy Pathways",
            "text": "Targets mitochondrial function and cellular energy production — central pathways in how the body produces and uses energy."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Recovery Support",
            "text": "May support growth hormone secretion, cellular repair, and recovery processes as directed by an independent licensed provider."
          }
        },
        {
          "type": "step",
          "settings": {
            "title": "Longevity Applications",
            "text": "Used in provider-guided longevity protocols for their effects on cellular signaling pathways associated with healthy aging."
          }
        }
      ]
    }
  ]
}
{% endschema %}
