{% render 'chopinrx-tokens' %}

{% liquid
  assign arrow_icon = 'icon-arrow-right.svg' | inline_asset_content | replace: '#FCFAF9', 'currentColor'
  assign dot_icon = 'icon-eyebrow-dot.svg' | inline_asset_content
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_count
%}

<div class="chx-insights">
  <div class="chx-container">
    <div class="chx-insights__header">
      {% render 'chopinrx-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        class: 'chx-insights__heading'
      %}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="chx-btn chx-btn--md chx-btn--secondary chx-insights__cta"
          href="{{ section.settings.cta_url | default: blog.url }}"
        >
          <span>{{ section.settings.cta_label }}</span>
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
      <ul class="chx-insights__grid" role="list">
        {%- for article in blog.articles limit: limit -%}
          <li>
            {% render 'chopinrx-article-card',
              article: article,
              read_more: section.settings.read_more_label,
              exclude_tag: section.settings.featured_tag
            %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .chx-insights {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
    overflow: clip;
  }

  .chx-insights__header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .chx-insights__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chx-insights__cta {
    flex-shrink: 0;
  }

  .chx-insights__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-insights__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 767px) {
    .chx-insights {
      padding-block: var(--space-10);
    }

    /* The action moves under the articles on mobile. */
    .chx-insights > .chx-container {
      display: flex;
      flex-direction: column;
    }

    .chx-insights__header {
      display: contents;
    }

    .chx-insights__heading {
      order: 1;
      align-items: center;
      text-align: center;
    }

    .chx-insights__grid {
      order: 2;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    /* Scoped under the section root: the shared button primitive sets the same
       properties at the same specificity and the bundle order is not fixed. */
    .chx-insights .chx-insights__cta {
      order: 3;
      align-self: center;
      height: var(--control-h-lg);
      margin-block-start: var(--space-8);
      padding-inline: var(--space-8);
      font-size: var(--font-size-button-large);
      line-height: 1.33;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Insights",
  "tag": "section",
  "class": "chopinrx-insights-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest insights"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "label": "Posts",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "featured_tag",
      "label": "Tag to hide on cards",
      "default": "featured"
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Insights"
    }
  ]
}
{% endschema %}
