{% render 'chopinrx-tokens' %}

{% liquid
  assign arrow_icon = 'icon-arrow-right.svg' | inline_asset_content | replace: '#FCFAF9', 'currentColor'
  assign dot_icon = 'icon-eyebrow-dot.svg' | inline_asset_content
  assign blog = blogs[section.settings.blog]
  assign limit = section.settings.posts_count
%}

<div class="chx-insights">
  <div class="chx-container">
    <div class="chx-insights__header">
      {% render 'chopinrx-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        class: 'chx-insights__heading'
      %}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="chx-btn chx-btn--md chx-btn--secondary chx-insights__cta"
          href="{{ section.settings.cta_url | default: blog.url }}"
        >
          <span>{{ section.settings.cta_label }}</span>
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if blog.articles_count > 0 -%}
      <ul class="chx-insights__grid" role="list">
        {%- for article in blog.articles limit: limit -%}
          <li class="chx-article">
            <a class="chx-article__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image != blank -%}
                <img
                  src="{{ article.image | image_url: width: 900 }}"
                  srcset="
                    {{ article.image | image_url: width: 450 }} 450w,
                    {{ article.image | image_url: width: 900 }} 900w
                  "
                  sizes="(min-width: 1025px) 33vw, (min-width: 768px) 50vw, 100vw"
                  width="{{ article.image.width }}"
                  height="{{ article.image.height }}"
                  alt="{{ article.image.alt | escape }}"
                  loading="lazy"
                >
              {%- endif -%}
            </a>

            <div class="chx-article__body">
              <p class="chx-article__meta">
                {%- if article.tags.size > 0 -%}
                  <span class="chx-article__tag">{{ article.tags.first }}</span>
                  <span class="chx-eyebrow__dot" aria-hidden="true">{{ dot_icon }}</span>
                {%- endif -%}
                <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">
                  {{- article.published_at | date: format: 'date' -}}
                </time>
              </p>

              <h3 class="chx-h5 chx-article__title">
                <a href="{{ article.url }}">{{ article.title }}</a>
              </h3>

              {%- if article.excerpt_or_content != blank -%}
                <p class="chx-article__dek">
                  {{- article.excerpt_or_content | strip_html | truncatewords: 24 -}}
                </p>
              {%- endif -%}
            </div>

            <span class="chx-article__more" aria-hidden="true">
              <span>{{ section.settings.read_more_label }}</span>
              <span class="chx-btn__icon chx-article__more-icon">{{ arrow_icon }}</span>
            </span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .chx-insights {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
    overflow: clip;
  }

  .chx-insights__header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-8);
  }

  .chx-insights__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chx-insights__cta {
    flex-shrink: 0;
  }

  .chx-insights__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--grid-gap);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ── Article card ───────────────────────────── */
  .chx-article {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .chx-article__media {
    display: block;
    height: 266px;
    border-radius: var(--radius-lg);
    overflow: clip;
    background-color: var(--text-muted);
  }

  .chx-article__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s var(--ease-out-cubic, ease);
  }

  .chx-article:hover .chx-article__media img {
    transform: scale(1.04);
  }

  .chx-article__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chx-article__meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-label-tag);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.005em;
    color: var(--text-muted);
  }

  .chx-article__tag {
    text-transform: uppercase;
  }

  .chx-article__title a {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .chx-article:hover .chx-article__title a {
    color: var(--text-accent);
  }

  .chx-article__dek {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 400;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .chx-article__more {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--font-size-button-large);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.005em;
    color: var(--text-heading);
  }

  .chx-article__more-icon {
    color: var(--text-accent);
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-insights__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .chx-article__media {
      height: 220px;
    }
  }

  @media screen and (max-width: 767px) {
    .chx-insights {
      padding-block: var(--space-10);
    }

    /* The action moves under the articles on mobile. */
    .chx-insights > .chx-container {
      display: flex;
      flex-direction: column;
    }

    .chx-insights__header {
      display: contents;
    }

    .chx-insights__heading {
      order: 1;
      align-items: center;
      text-align: center;
    }

    .chx-insights__grid {
      order: 2;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8);
    }

    /* Scoped under the section root: the shared button primitive sets the same
       properties at the same specificity and the bundle order is not fixed. */
    .chx-insights .chx-insights__cta {
      order: 3;
      align-self: center;
      height: var(--control-h-lg);
      margin-block-start: var(--space-8);
      padding-inline: var(--space-8);
      font-size: var(--font-size-button-large);
      line-height: 1.33;
    }

    .chx-article__media {
      height: 266px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chx-article__media img {
      transition: none;
    }

    .chx-article:hover .chx-article__media img {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Insights",
  "tag": "section",
  "class": "chopinrx-insights-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our blog"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest insights"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "range",
      "id": "posts_count",
      "label": "Posts",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Insights"
    }
  ]
}
{% endschema %}
