{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign check_icon = 'icon-tx-check-box.svg' | inline_asset_content
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title
  assign image = section.settings.image | default: product.featured_media.preview_image
  assign highlights = product.metafields.custom.highlights.value
  assign items = section.blocks | where: 'type', 'point'
  assign has_points = false
  if highlights.size > 0 or items.size > 0
    assign has_points = true
  endif
%}

{%- if heading != blank or has_points -%}
  <div class="chx-tx chx-txabout">
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2400
        | image_tag:
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          loading: 'lazy',
          class: 'chx-txabout__image',
          alt: ''
      }}
    {%- endif -%}

    <div class="chx-txabout__inner">
      <div class="chx-txabout__content">
        {%- if eyebrow != blank -%}
          <p class="chx-txlabel chx-txabout__eyebrow">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="chx-txtitle chx-txabout__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if has_points -%}
          <ul class="chx-txabout__list" role="list">
            {%- if highlights.size > 0 -%}
              {%- for line in highlights -%}
                <li class="chx-txabout__item">
                  <span class="chx-txabout__icon" aria-hidden="true">{{ check_icon }}</span>
                  <span>{{ line }}</span>
                </li>
              {%- endfor -%}
            {%- else -%}
              {%- for block in items -%}
                <li class="chx-txabout__item" {{ block.shopify_attributes }}>
                  <span class="chx-txabout__icon" aria-hidden="true">{{ check_icon }}</span>
                  <span>{{ block.settings.text }}</span>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .chx-txabout {
    position: relative;
    display: flex;
    align-items: center;
    min-height: 720px;
    overflow: hidden;
    background: var(--surface-dark);
    color: var(--text-on-dark);
  }

  .chx-txabout .chx-txabout__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-txabout__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: var(--space-24) var(--chx-gutter);
  }

  /* The scrim is anchored to the copy column, not to a % of the image, so it
     covers the text at every width. */
  .chx-txabout::before {
    content: '';
    position: absolute;
    z-index: 1;
    inset: 0 auto 0 0;
    width: calc(var(--chx-gutter) + 720px);
    max-width: 100%;
    background: linear-gradient(90deg, rgb(13 37 53 / 88%) 0%, rgb(13 37 53 / 72%) 70%, rgb(13 37 53 / 0%) 100%);
    pointer-events: none;
  }

  .chx-txabout__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 560px;
  }

  .chx-txabout {
    --chx-txlabel-color: var(--text-on-dark);
    --chx-txtitle-color: var(--text-on-dark);
  }

  .chx-txabout__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-txabout__item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    font-size: var(--font-size-body-large);
    line-height: 1.4;
  }

  .chx-txabout__icon {
    display: inline-flex;
    flex-shrink: 0;
    width: 18px;
    height: 18px;
    margin-top: 3px;
    color: var(--text-on-dark);
  }

  .chx-txabout__icon svg {
    width: 100%;
    height: 100%;
  }

  @media (max-width: 1024px) {
    .chx-txabout {
      min-height: 600px;
    }

    .chx-txabout__inner {
      padding-block: var(--space-16);
    }
  }

  @media (max-width: 767px) {
    .chx-txabout {
      align-items: flex-end;
      min-height: 560px;
    }

    .chx-txabout__inner {
      padding-block: var(--space-10);
    }

    .chx-txabout::before {
      inset: 0;
      width: auto;
      background: linear-gradient(0deg, rgb(13 37 53 / 92%) 0%, rgb(13 37 53 / 75%) 55%, rgb(13 37 53 / 15%) 100%);
    }

    .chx-txabout__item {
      font-size: var(--font-size-body);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment about",
  "tag": "section",
  "class": "chopinrx-tx-about-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The check list comes from the product's Highlights custom field. The points below are only used when it is empty. [product] is replaced by the product name."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "01 / About [product]"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fuel what keeps you going"
    }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Guided by licensed providers"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment about"
    }
  ]
}
{% endschema %}
