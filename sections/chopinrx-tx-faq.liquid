{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign plus_icon = 'icon-faq-plus.svg' | inline_asset_content
  assign minus_icon = 'icon-faq-minus.svg' | inline_asset_content
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title

  # The product's FAQ custom field wins; the section's questions are the fallback.
  assign items = product.metafields.custom.faq_items.value
  if items.size > 0
    assign rows = empty
  else
    assign rows = section.blocks | where: 'type', 'question'
  endif

  assign variant = product.selected_or_first_available_variant
  assign intake_url = variant.metafields.custom.mydos_link.value | default: product.metafields.custom.mydos_link.value | default: '' | strip
  if product.tags contains 'coming-soon'
    assign intake_url = ''
  endif
%}

{%- if items.size > 0 or rows.size > 0 -%}
  <div class="chx-tx chx-txfaq">
    <div class="chx-container chx-txfaq__inner">
      <div class="chx-txfaq__intro">
        {%- if eyebrow != blank -%}
          <p class="chx-txlabel">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="chx-txtitle chx-txfaq__title">{{ heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <p class="chx-txfaq__text">{{ section.settings.text }}</p>
        {%- endif -%}
        {%- if section.settings.cta_label != blank and intake_url != blank -%}
          <a class="chx-txbtn chx-txfaq__cta" href="{{ intake_url }}">{{ section.settings.cta_label }}</a>
        {%- endif -%}
      </div>

      <div class="chx-faq__list chx-txacc chx-txfaq__list">
        {%- for item in items -%}
          <details class="chx-faq__item" {% if item.open.value %}open{% endif %}>
            <summary class="chx-faq__question">
              <span class="chx-faq__question-text">{{ item.question.value }}</span>
              <span class="chx-faq__toggle" aria-hidden="true">
                <span class="chx-faq__toggle-icon chx-faq__toggle-icon--closed">{{ plus_icon }}</span>
                <span class="chx-faq__toggle-icon chx-faq__toggle-icon--open">{{ minus_icon }}</span>
              </span>
            </summary>
            <div class="chx-faq__answer">{% render 'chopinrx-rich-block', field: item.answer %}</div>
          </details>
        {%- endfor -%}
        {%- for block in rows -%}
          <details class="chx-faq__item" {% if block.settings.open %}open{% endif %} {{ block.shopify_attributes }}>
            <summary class="chx-faq__question">
              <span class="chx-faq__question-text">{{ block.settings.question | replace: '[product]', product.title }}</span>
              <span class="chx-faq__toggle" aria-hidden="true">
                <span class="chx-faq__toggle-icon chx-faq__toggle-icon--closed">{{ plus_icon }}</span>
                <span class="chx-faq__toggle-icon chx-faq__toggle-icon--open">{{ minus_icon }}</span>
              </span>
            </summary>
            <div class="chx-faq__answer">{{ block.settings.answer | replace: '[product]', product.title }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>

  {%- capture faq_entities -%}
    {%- for item in items -%}
      {
        "@type": "Question",
        "name": {{ item.question.value | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ item.answer | metafield_tag | strip_html | strip | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
    {%- for block in rows -%}
      {
        "@type": "Question",
        "name": {{ block.settings.question | replace: '[product]', product.title | strip_html | json }},
        "acceptedAnswer": {
          "@type": "Answer",
          "text": {{ block.settings.answer | replace: '[product]', product.title | strip_html | strip | json }}
        }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  {%- endcapture -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [{{ faq_entities }}]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .chx-txfaq {
    padding-block: var(--space-24);
    background: var(--surface-card);
  }

  .chx-txfaq__inner {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: start;
    gap: var(--space-16);
  }

  .chx-txfaq__intro {
    position: sticky;
    top: calc(var(--chx-top-offset, 80px) + var(--space-6));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .chx-txfaq .chx-txfaq__title {
    font-size: var(--font-size-h3);
  }

  .chx-txfaq__text {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--font-size-body-large);
    line-height: 1.5;
  }

  .chx-txfaq .chx-txfaq__cta {
    margin-top: var(--space-4);
  }

  @media (max-width: 1024px) {
    .chx-txfaq {
      padding-block: var(--space-16);
    }

    .chx-txfaq__inner {
      grid-template-columns: 1fr;
      gap: var(--space-10);
    }

    .chx-txfaq__intro {
      position: static;
    }
  }

  @media (max-width: 767px) {
    .chx-txfaq {
      padding-block: var(--space-10);
    }

    .chx-txfaq__inner {
      gap: var(--space-8);
    }

    .chx-txfaq .chx-txfaq__cta {
      width: 100%;
      justify-content: center;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment FAQ",
  "tag": "section",
  "class": "chopinrx-tx-faq-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Questions come from the product's FAQ items custom field. The blocks below are only used when it is empty. [product] is replaced by the product name."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "06 / Frequently asked questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Questions? We have answers"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "info": "Optional. Links to the product's MyDose intake and hides without one."
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How does [product] work?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        },
        {
          "type": "checkbox",
          "id": "open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment FAQ"
    }
  ]
}
{% endschema %}
