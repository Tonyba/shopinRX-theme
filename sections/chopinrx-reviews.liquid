{% render 'chopinrx-tokens' %}

{% liquid
  assign star_icon = 'icon-star-trustpilot.svg' | inline_asset_content
  assign reviews = section.blocks | where: 'type', 'review'
%}

<div class="chx-reviews">
  <div class="chx-container">
    {% render 'chopinrx-section-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      centered: true
    %}
  </div>

  <div class="chx-reviews__rail">
    {%- for row in (1..2) -%}
      {%- assign row_key = row | append: '' -%}
      <div class="chx-marquee chx-marquee--{{ row }}">
        <ul class="chx-marquee__track" role="list">
          {%- comment -%}
            The track is rendered twice so the translation can loop seamlessly.
            The duplicate is hidden from assistive tech.
          {%- endcomment -%}
          {%- for pass in (1..2) -%}
            {%- for block in reviews -%}
              {%- assign block_row = block.settings.row | default: '1' -%}
              {%- if block_row == row_key -%}
                <li
                  class="chx-review"
                  {% if pass == 2 %}
                    aria-hidden="true"
                  {% endif %}
                  {{ block.shopify_attributes }}
                >
                  <div class="chx-review__head">
                    <p class="chx-review__name">{{ block.settings.name }}</p>
                    <div class="chx-review__stars" role="img" aria-label="{{ block.settings.rating }} / 5">
                      {%- for i in (1..block.settings.rating) -%}
                        <span class="chx-review__star" aria-hidden="true">{{ star_icon }}</span>
                      {%- endfor -%}
                    </div>
                  </div>
                  <p class="chx-review__quote">{{ block.settings.quote }}</p>
                </li>
              {%- endif -%}
            {%- endfor -%}
          {%- endfor -%}
        </ul>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.show_trustpilot -%}
    <div class="chx-container">
      <div class="chx-reviews__trustpilot">
        {% render 'chopinrx-trustpilot',
          rating: section.settings.trustpilot_rating,
          score: section.settings.trustpilot_score,
          count: section.settings.trustpilot_count,
          url: section.settings.trustpilot_url,
          ink: true
        %}
      </div>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .chx-reviews {
    background-color: var(--surface-muted);
    padding-block: var(--section-py-tight);
    overflow: clip;
  }

  .chx-reviews__rail {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-block-start: var(--space-8);
  }

  .chx-marquee {
    overflow: hidden;
  }

  .chx-marquee__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: chx-marquee-left 60s linear infinite;
  }

  .chx-marquee--2 .chx-marquee__track {
    animation-name: chx-marquee-right;
  }

  .chx-marquee:hover .chx-marquee__track,
  .chx-marquee:focus-within .chx-marquee__track {
    animation-play-state: paused;
  }

  @keyframes chx-marquee-left {
    from {
      transform: translate3d(0, 0, 0);
    }

    to {
      transform: translate3d(-50%, 0, 0);
    }
  }

  @keyframes chx-marquee-right {
    from {
      transform: translate3d(-50%, 0, 0);
    }

    to {
      transform: translate3d(0, 0, 0);
    }
  }

  /* ── Review card ────────────────────────────── */
  .chx-review {
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
    width: 471px;
    min-height: 254px;
    /* Spacing between cards comes from card padding, not a track gap. */
    margin-inline-end: 12px;
    padding: var(--space-8);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card-flat);
  }

  .chx-review__head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .chx-review__name {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    font-weight: 600;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: #001908;
  }

  .chx-review__stars {
    display: flex;
    gap: 4px;
  }

  .chx-review__star {
    display: block;
    width: 20px;
    height: 20px;
  }

  .chx-review__star svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chx-review__quote {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    font-weight: 400;
    line-height: 1.55;
    letter-spacing: -0.005em;
    color: var(--text-body);
  }

  .chx-reviews__trustpilot {
    display: flex;
    justify-content: center;
    margin-block-start: var(--space-8);
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 767px) {
    .chx-reviews {
      padding-block: var(--space-10);
    }

    .chx-reviews__rail {
      margin-block-start: 30px;
    }

    .chx-reviews__trustpilot {
      margin-block-start: 30px;
    }

    .chx-review {
      width: 300px;
      min-height: 0;
      padding: var(--space-5);
    }

    .chx-review__name,
    .chx-review__quote {
      font-size: var(--font-size-body);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chx-marquee {
      overflow-x: auto;
    }

    .chx-marquee__track {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "tag": "section",
  "class": "chopinrx-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "4.8/5 on Trust Pilot"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "info": "Italic text is rendered in the accent colour.",
      "default": "More than <em>100,000</em> patients trust our treatment plans"
    },
    {
      "type": "header",
      "content": "Trustpilot"
    },
    {
      "type": "checkbox",
      "id": "show_trustpilot",
      "label": "Show Trustpilot strip",
      "default": true
    },
    {
      "type": "text",
      "id": "trustpilot_rating",
      "label": "Rating word",
      "default": "Excellent"
    },
    {
      "type": "text",
      "id": "trustpilot_score",
      "label": "Score (mobile)",
      "default": "4.6"
    },
    {
      "type": "text",
      "id": "trustpilot_count",
      "label": "Review count",
      "default": "436 reviews on"
    },
    {
      "type": "url",
      "id": "trustpilot_url",
      "label": "Trustpilot link"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "James Whitfield"
        },
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "\"I really love how simple and easy everything has been so far. I have noticed an enhanced focused on being more mindful of what I am eating, making sure to hit my protein goals!\""
        },
        {
          "type": "select",
          "id": "row",
          "label": "Row",
          "options": [
            { "value": "1", "label": "Top row" },
            { "value": "2", "label": "Bottom row" }
          ],
          "default": "1"
        }
      ]
    }
  ],
  "max_blocks": 24,
  "presets": [
    {
      "name": "Reviews"
    }
  ]
}
{% endschema %}
