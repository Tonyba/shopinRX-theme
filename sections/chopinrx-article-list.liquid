{% render 'chopinrx-tokens' %}

{% liquid
  assign chevron_icon = 'icon-chevron-right.svg' | inline_asset_content | replace: '#FF6E42', 'currentColor'
  assign featured_tag = section.settings.featured_tag | downcase
  assign per_page = section.settings.per_page | default: 9
%}

<div class="chx-articles">
  <div class="chx-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="chx-h2 chx-articles__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if blog.all_tags.size > 0 -%}
      {%- comment -%}
        Tabs are Shopify's own tag routes, so filtering is a real request:
        pagination, canonical URLs and no-JS all keep working.
      {%- endcomment -%}
      <nav class="chx-chips chx-articles__tabs" aria-label="{{ section.settings.tabs_label }}">
        <a
          class="chx-chip{% if current_tags.size == 0 %} chx-chip--active{% endif %}"
          href="{{ blog.url }}"
          {% if current_tags.size == 0 %}
            aria-current="page"
          {% endif %}
        >
          {{- section.settings.all_label -}}
        </a>

        {%- for tag in blog.all_tags -%}
          {%- liquid
            assign tag_key = tag | downcase
            if tag_key == featured_tag
              continue
            endif
            assign is_active = false
            if current_tags contains tag
              assign is_active = true
            endif
          -%}
          <a
            class="chx-chip{% if is_active %} chx-chip--active{% endif %}"
            href="{{ blog.url }}/tagged/{{ tag | handleize }}"
            {% if is_active %}
              aria-current="page"
            {% endif %}
          >
            {{- tag -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by per_page -%}
      {%- if blog.articles.size > 0 -%}
        <ul class="chx-articles__grid" role="list">
          {%- for article in blog.articles -%}
            <li>
              {% render 'chopinrx-article-card',
                article: article,
                exclude_tag: section.settings.featured_tag,
                read_more: section.settings.read_more_label
              %}
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="chx-articles__empty">{{ section.settings.empty_text }}</p>
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="chx-pagination" aria-label="{{ 'content.pagination.nav_label' | t }}">
          {%- if paginate.previous -%}
            <a
              class="chx-pagination__arrow chx-pagination__arrow--prev"
              href="{{ paginate.previous.url }}"
              aria-label="{{ 'content.pagination.previous' | t }}"
            >
              <span aria-hidden="true">{{ chevron_icon }}</span>
            </a>
          {%- else -%}
            <span class="chx-pagination__arrow chx-pagination__arrow--prev" aria-hidden="true">
              {{- chevron_icon -}}
            </span>
          {%- endif -%}

          <ol class="chx-pagination__pages" role="list">
            {%- for part in paginate.parts -%}
              <li>
                {%- if part.is_link -%}
                  <a class="chx-pagination__page" href="{{ part.url }}">{{ part.title }}</a>
                {%- elsif part.title == paginate.current_page -%}
                  <span class="chx-pagination__page chx-pagination__page--current" aria-current="page">
                    {{- part.title -}}
                  </span>
                {%- else -%}
                  <span class="chx-pagination__gap" aria-hidden="true">{{ part.title }}</span>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ol>

          {%- if paginate.next -%}
            <a
              class="chx-pagination__arrow"
              href="{{ paginate.next.url }}"
              aria-label="{{ 'content.pagination.next' | t }}"
            >
              <span aria-hidden="true">{{ chevron_icon }}</span>
            </a>
          {%- else -%}
            <span class="chx-pagination__arrow" aria-hidden="true">{{ chevron_icon }}</span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</div>

{% stylesheet %}
  .chx-articles {
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
  }

  .chx-articles__heading {
    margin-block-end: var(--space-8);
  }

  /* The rule above the tabs, as drawn. Scoped under the section root: the chip
     row primitive sets padding at the same specificity and the bundle order is
     not fixed. */
  .chx-articles .chx-articles__tabs {
    padding-block-start: var(--space-8);
    border-block-start: var(--border-w) solid var(--border-hairline);
  }

  .chx-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: var(--space-6);
    row-gap: var(--space-16);
    margin: var(--space-8) 0 0;
    padding: 0;
    list-style: none;
  }

  .chx-articles__empty {
    margin: var(--space-8) 0 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    color: var(--text-muted);
  }

  /* ── Pagination ─────────────────────────────── */
  .chx-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin-block-start: var(--space-16);
  }

  .chx-pagination__pages {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-pagination__page,
  .chx-pagination__gap,
  .chx-pagination__arrow {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-md);
    font-family: var(--font-ui);
    font-size: var(--font-size-button);
    font-weight: 500;
    line-height: 1.25;
    color: var(--text-heading);
    text-decoration: none;
  }

  a.chx-pagination__page:hover,
  a.chx-pagination__arrow:hover {
    background-color: var(--surface-well);
    color: var(--text-heading);
    text-decoration: none;
  }

  .chx-pagination__page--current {
    background-color: var(--surface-dark);
    font-weight: 600;
    color: var(--text-on-dark);
  }

  .chx-pagination__gap {
    color: var(--text-muted);
  }

  .chx-pagination__arrow svg {
    display: block;
    width: 20px;
    height: 20px;
  }

  .chx-pagination__arrow--prev svg {
    transform: rotate(180deg);
  }

  /* A missing previous or next keeps its slot so the row stays centred. */
  span.chx-pagination__arrow {
    opacity: 0.3;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-articles__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 767px) {
    .chx-articles {
      padding-block: var(--space-10);
    }

    .chx-articles__grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .chx-articles .chx-articles__tabs {
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
    }

    .chx-articles__tabs::-webkit-scrollbar {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Article list",
  "tag": "section",
  "class": "chopinrx-article-list-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recent articles"
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "All tab label",
      "default": "All"
    },
    {
      "type": "text",
      "id": "tabs_label",
      "label": "Tabs accessible name",
      "default": "Filter articles by topic"
    },
    {
      "type": "text",
      "id": "featured_tag",
      "label": "Featured tag",
      "info": "Hidden from the tabs and from the card's topic line.",
      "default": "featured"
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "Articles per page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "text",
      "id": "read_more_label",
      "label": "Read more label",
      "default": "Read More"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state",
      "default": "No articles here yet."
    }
  ],
  "presets": [
    {
      "name": "Article list"
    }
  ]
}
{% endschema %}
