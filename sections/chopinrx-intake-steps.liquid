{% render 'chopinrx-tokens' %}

{%- assign heading_id = section.id | append: '-heading' -%}

<section class="chx-intake-steps" aria-labelledby="{{ heading_id }}">
  <div class="chx-container">
    {% render 'chopinrx-split-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      body: section.settings.body,
      heading_id: heading_id
    %}

    <ol class="chx-intake-steps__list">
      {%- for block in section.blocks -%}
        <li class="chx-intake-steps__item" {{ block.shopify_attributes }}>
          <span class="chx-intake-steps__number" aria-hidden="true">
            {{- forloop.index | prepend: '0' | slice: -2, 2 -}}
          </span>
          <h3 class="chx-intake-steps__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="chx-intake-steps__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% stylesheet %}
  .chx-intake-steps {
    padding-block: var(--section-py-tight) 0;
    background-color: var(--surface-page);
  }

  .chx-intake-steps__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .chx-intake-steps__item {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
  }

  .chx-intake-steps__number {
    display: flex;
    align-items: center;
    min-height: 100px;
    padding-inline: var(--space-6);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    font-family: var(--font-display);
    font-size: var(--font-size-h3);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-accent);
  }

  .chx-intake-steps__title {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: var(--font-size-subtitle);
    font-weight: 600;
    line-height: 1.28;
    letter-spacing: -0.01em;
    color: var(--text-heading);
  }

  .chx-intake-steps__text {
    margin: var(--space-2) 0 0;
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media screen and (max-width: 767px) {
    .chx-intake-steps__list {
      grid-template-columns: minmax(0, 1fr);
    }

    .chx-intake-steps__number {
      min-height: 80px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Intake steps",
  "tag": "div",
  "class": "chopinrx-intake-steps-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Three steps. No waiting room."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Choose"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Intake steps"
    }
  ]
}
{% endschema %}
