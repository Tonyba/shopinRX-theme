{% render 'chopinrx-tokens' %}

{% liquid
  assign arrow_icon = 'icon-arrow-right.svg' | inline_asset_content | replace: '#FCFAF9', 'currentColor'
  assign dot_icon = 'icon-eyebrow-dot.svg' | inline_asset_content
  assign tabs = section.settings.collections
  assign unit = section.settings.price_unit
  assign primary = section.settings.primary_collection
%}

<div class="chx-explore" data-chx-tabs>
  <div class="chx-container">
    <div class="chx-explore__header">
      {% render 'chopinrx-section-heading',
        eyebrow: section.settings.eyebrow,
        heading: section.settings.heading,
        class: 'chx-explore__heading'
      %}

      {%- if section.settings.cta_label != blank -%}
        <a
          class="chx-btn chx-btn--secondary chx-explore__cta"
          href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}"
        >
          <span>{{ section.settings.cta_label }}</span>
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </a>
      {%- endif -%}
    </div>

    {%- if tabs.count > 1 -%}
      <div
        class="chx-chips chx-explore__toolbar"
        role="tablist"
        aria-label="{{ section.settings.heading | escape }}"
      >
        {%- for tab in tabs -%}
          <button
            type="button"
            role="tab"
            class="chx-chip{% if forloop.first %} chx-chip--active{% endif %}"
            id="chx-tab-{{ section.id }}-{{ forloop.index }}"
            aria-controls="chx-panel-{{ section.id }}-{{ forloop.index }}"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
            data-chx-tab
          >
            {{- tab.title | escape -}}
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  {%- for tab in tabs -%}
    <div
      class="chx-explore__rail"
      id="chx-panel-{{ section.id }}-{{ forloop.index }}"
      {% if tabs.count > 1 %}
        role="tabpanel"
        aria-labelledby="chx-tab-{{ section.id }}-{{ forloop.index }}"
        tabindex="0"
      {% endif %}
      {% unless forloop.first %}
        hidden
      {% endunless %}
      data-chx-panel
      data-chx-carousel
    >
      <div class="chx-carousel__viewport" data-chx-carousel-viewport>
        <ul class="chx-carousel__container" role="list">
          {%- assign shown = 0 -%}
          {%- for product in tab.products -%}
            {%- liquid
              # A goal collection holds programs and treatments alike, so the
              # primary collection is what keeps the two from mixing. The count
              # is tracked by hand because the limit would otherwise apply
              # before the filter and cut the tab short.
              if shown >= section.settings.products_count
                break
              endif

              if primary != blank
                assign product_collections = product.collections | map: 'handle'
                unless product_collections contains primary.handle
                  continue
                endunless
              endif

              assign shown = shown | plus: 1

              assign summary = product.metafields.custom.summary.value
              if summary == blank
                assign summary = product.description | strip_html | truncatewords: 14
              endif
            -%}
            <li class="chx-carousel__slide chx-productcard">
              <a class="chx-productcard__media" href="{{ product.url }}" tabindex="-1" aria-hidden="true">
                {%- if product.featured_image -%}
                  <img
                    src="{{ product.featured_image | image_url: width: 700 }}"
                    srcset="
                      {{ product.featured_image | image_url: width: 350 }} 350w,
                      {{ product.featured_image | image_url: width: 700 }} 700w
                    "
                    sizes="348px"
                    width="{{ product.featured_image.width }}"
                    height="{{ product.featured_image.height }}"
                    alt="{{ product.featured_image.alt | escape }}"
                    loading="lazy"
                  >
                {%- else -%}
                  <span class="chx-productcard__placeholder">{{ section.settings.placeholder_label }}</span>
                {%- endif -%}

                <span class="chx-productcard__price">
                  <span class="chx-productcard__price-dot" aria-hidden="true">{{ dot_icon }}</span>
                  <span>
                    {%- if section.settings.price_prefix != blank -%}
                      {{ section.settings.price_prefix }}&nbsp;
                    {%- endif -%}
                    {{- product.price | money_without_trailing_zeros }}{{ unit -}}
                  </span>
                </span>
              </a>

              <div class="chx-productcard__body">
                <h3 class="chx-h5 chx-productcard__title">
                  <a href="{{ product.url }}">{{ product.title | escape }}</a>
                </h3>
                {%- if summary != blank -%}
                  <p class="chx-productcard__text">{{ summary }}</p>
                {%- endif -%}
              </div>

              <a class="chx-productcard__link" href="{{ product.url }}">
                <span>{{ section.settings.card_cta_label }}</span>
                <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
              </a>
            </li>
          {%- endfor -%}

          {%- if shown == 0 -%}
            <li class="chx-explore__empty">{{ 'content.no_products_found' | t }}</li>
          {%- endif -%}
        </ul>
      </div>

      <div class="chx-explore__fade" aria-hidden="true"></div>

      <div class="chx-explore__controls">
        <button
          type="button"
          class="chx-carousel__control chx-carousel__control--prev"
          aria-label="{{ 'content.pagination.previous' | t }}"
          data-chx-carousel-prev
        >
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </button>
        <button
          type="button"
          class="chx-carousel__control"
          aria-label="{{ 'content.pagination.next' | t }}"
          data-chx-carousel-next
        >
          <span class="chx-btn__icon" aria-hidden="true">{{ arrow_icon }}</span>
        </button>
      </div>
    </div>
  {%- endfor -%}
</div>

<script type="module">
  import EmblaCarousel from '{{ 'embla-carousel.js' | asset_url }}';
  import { initCarousels } from '{{ 'chopinrx-carousel.js' | asset_url }}';
  {%- if tabs.count > 1 %}
    import { initTabs } from '{{ 'chopinrx-tabs.js' | asset_url }}';
    initTabs();
  {%- endif %}
  initCarousels(EmblaCarousel);
</script>

{% stylesheet %}
  .chx-explore {
    position: relative;
    background-color: var(--surface-page);
    padding-block: var(--section-py-tight);
  }

  .chx-explore__header {
    display: flex;
    align-items: flex-end;
    gap: var(--space-16);
  }

  .chx-explore__heading {
    flex: 1 1 auto;
    min-width: 0;
  }

  .chx-explore__cta {
    flex-shrink: 0;
  }

  .chx-explore__toolbar {
    margin-block-start: var(--space-6);
  }

  .chx-explore__rail {
    position: relative;
    margin-block-start: var(--space-6);
    padding-inline-start: var(--chx-gutter);
  }

  .chx-explore__rail[hidden] {
    display: none;
  }

  .chx-explore__empty {
    padding-inline-start: var(--space-5);
    font-family: var(--font-ui);
    font-size: var(--font-size-body-large);
    color: var(--text-muted);
  }

  /* ── Carousel shell ─────────────────────────── */
  .chx-carousel__viewport {
    overflow: hidden;
  }

  .chx-carousel__container {
    --chx-slide-spacing: var(--space-5);

    display: flex;
    margin: 0;
    margin-inline-start: calc(var(--chx-slide-spacing) * -1);
    padding: 0;
    list-style: none;
    touch-action: pan-y pinch-zoom;
  }

  .chx-carousel__slide {
    flex: 0 0 368px;
    min-width: 0;
    /* Spacing between slides comes from slide padding, not a column gap. */
    padding-inline-start: var(--chx-slide-spacing);
  }

  .chx-explore__fade {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    width: var(--chx-gutter);
    background-image: linear-gradient(to right, rgb(255 255 255 / 0%), var(--surface-page) 60%);
    pointer-events: none;
  }

  .chx-explore__controls {
    position: absolute;
    top: 150px;
    inset-inline-end: var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chx-carousel__control {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    padding: 0;
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-pill);
    background-color: var(--surface-page);
    color: var(--text-heading);
    cursor: pointer;
    transition: background-color 0.2s ease, opacity 0.2s ease;
  }

  .chx-carousel__control:hover {
    background-color: var(--surface-muted);
  }

  .chx-carousel__control[disabled] {
    opacity: 0;
    pointer-events: none;
  }

  .chx-carousel__control--prev .chx-btn__icon {
    transform: rotate(180deg);
  }

  /* ── Product card ───────────────────────────── */
  .chx-productcard {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .chx-productcard__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 300px;
    border-radius: var(--radius-lg);
    background-color: var(--surface-well);
    overflow: clip;
  }

  .chx-productcard__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .chx-productcard__placeholder {
    font-family: var(--font-ui);
    font-size: var(--font-size-label-tag);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.005em;
    color: var(--text-muted);
  }

  .chx-productcard__price {
    position: absolute;
    top: 12px;
    left: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    height: var(--pill-h);
    padding-inline: var(--space-3);
    border-radius: var(--radius-pill);
    background-color: var(--surface-page);
    font-family: var(--font-ui);
    font-size: var(--font-size-label-tag);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0.005em;
    color: var(--text-heading);
    white-space: nowrap;
  }

  .chx-productcard__price-dot {
    display: block;
    flex-shrink: 0;
    width: 7px;
    height: 7px;
  }

  .chx-productcard__price-dot svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .chx-productcard__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
  }

  .chx-productcard__title a {
    color: inherit;
    text-decoration: none;
  }

  .chx-productcard__title a:hover {
    color: var(--text-accent);
    text-decoration: none;
  }

  .chx-productcard__text {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--font-size-body);
    font-weight: 500;
    line-height: 1.5;
    letter-spacing: -0.005em;
    color: var(--text-muted);
  }

  .chx-productcard__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--font-size-button-large);
    font-weight: 600;
    line-height: 1.33;
    letter-spacing: -0.005em;
    color: var(--text-heading);
    text-decoration: none;
  }

  .chx-productcard__link:hover {
    color: var(--text-accent);
    text-decoration: none;
  }

  /* ── Breakpoints ────────────────────────────── */
  @media screen and (max-width: 1024px) {
    .chx-explore__header {
      gap: var(--space-8);
    }

    .chx-carousel__slide {
      flex-basis: 320px;
    }

    .chx-explore__controls {
      top: 120px;
    }
  }

  @media screen and (max-width: 767px) {
    .chx-explore {
      display: flex;
      flex-direction: column;
      padding-block: var(--space-10);
    }

    /* The rails are siblings of the container, so both wrappers dissolve to let
       the action be ordered after them. */
    .chx-explore > .chx-container,
    .chx-explore__header {
      display: contents;
    }

    .chx-explore__heading {
      order: 1;
      align-items: center;
      padding-inline: var(--section-px);
      text-align: center;
    }

    .chx-explore__toolbar {
      order: 2;
      padding-inline: var(--section-px);
    }

    .chx-explore__rail {
      order: 3;
    }

    .chx-explore__cta {
      order: 4;
      align-self: center;
      margin-block-start: var(--space-6);
    }

    /* Card width plus the slide's own spacing padding. */
    .chx-carousel__slide {
      flex-basis: 320px;
    }

    .chx-explore__controls {
      top: 154px;
      inset-inline-end: var(--section-px);
    }

    .chx-explore__fade {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatments carousel",
  "tag": "section",
  "class": "chopinrx-explore-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore solutions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our Treatments"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Tabs",
      "info": "One tab per collection, in this order. The first tab is selected.",
      "limit": 8
    },
    {
      "type": "collection",
      "id": "primary_collection",
      "label": "Primary collection",
      "info": "Only products that are also in this collection are shown, so programs and treatments do not mix in a shared goal tab. Leave empty to show everything in the tab."
    },
    {
      "type": "range",
      "id": "products_count",
      "label": "Products per tab",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 8
    },
    {
      "type": "header",
      "content": "Card"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_unit",
      "label": "Price unit",
      "info": "Appended after the product price, e.g. /mo.",
      "default": "/mo"
    },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "info": "Shown when a product has no image.",
      "default": "Vial · placeholder"
    },
    {
      "type": "text",
      "id": "card_cta_label",
      "label": "Card link label",
      "default": "Explore"
    },
    {
      "type": "paragraph",
      "content": "The benefit line reads the custom.summary product metafield and falls back to the product description."
    },
    {
      "type": "header",
      "content": "Section button"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "See All Treatments"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Treatments carousel"
    }
  ]
}
{% endschema %}
