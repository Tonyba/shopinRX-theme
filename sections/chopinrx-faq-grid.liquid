{% render 'chopinrx-tokens' %}

{%- assign heading_id = section.id | append: '-heading' -%}

<section class="chx-faq-grid" aria-labelledby="{{ heading_id }}">
  <div class="chx-container">
    {% render 'chopinrx-split-heading',
      eyebrow: section.settings.eyebrow,
      heading: section.settings.heading,
      body: section.settings.body,
      heading_id: heading_id
    %}

    <div class="chx-faq-grid__list">
      {%- for block in section.blocks -%}
        <div class="chx-faq-grid__item" {{ block.shopify_attributes }}>
          <h3 class="chx-faq-grid__question">{{ block.settings.question }}</h3>
          <div class="chx-faq-grid__answer">{{ block.settings.answer }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": {
              "@type": "Answer",
              "text": {{ block.settings.answer | strip_html | strip | json }}
            }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .chx-faq-grid {
    padding-block: var(--section-py-tight);
    background-color: var(--surface-page);
  }

  .chx-faq-grid__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4) var(--space-4);
    margin-block-start: var(--space-8);
  }

  .chx-faq-grid__item {
    padding: var(--space-5) var(--space-6);
    border: var(--border-w) solid var(--border-hairline);
    border-radius: var(--radius-lg);
    background-color: var(--surface-card);
  }

  .chx-faq-grid__question {
    margin: 0;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: -0.005em;
    color: var(--text-heading);
  }

  .chx-faq-grid__answer {
    margin-block-start: var(--space-2);
    font-family: var(--font-ui);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  .chx-faq-grid__answer > * {
    margin: 0;
  }

  @media screen and (max-width: 767px) {
    .chx-faq-grid__list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ grid",
  "tag": "div",
  "class": "chopinrx-faq-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "FAQ"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Good questions"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Text"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What's a protocol?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ grid"
    }
  ]
}
{% endschema %}
