{% render 'chopinrx-tokens' %}
{% render 'chopinrx-tx-base' %}

{% liquid
  assign eyebrow = section.settings.eyebrow | replace: '[product]', product.title
  assign heading = section.settings.heading | replace: '[product]', product.title
  assign items = product.metafields.custom.why_benefits.value
  assign blocks = section.blocks | where: 'type', 'benefit'
  assign count = items.size | plus: 0
  if count == 0
    assign count = blocks.size
  endif
%}

{%- if count > 0 -%}
  <div class="chx-tx chx-txbenefits">
    <div class="chx-container chx-txbenefits__inner">
      <header class="chx-txbenefits__header">
        {%- if eyebrow != blank -%}
          <p class="chx-txlabel">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="chx-txtitle">{{ heading }}</h2>
        {%- endif -%}
      </header>

      <ol class="chx-txbenefits__grid" role="list">
        {%- if items.size > 0 -%}
          {%- for item in items -%}
            <li class="chx-txbenefits__item">
              <span class="chx-txbenefits__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div class="chx-txbenefits__copy">
                <h3 class="chx-txbenefits__name">{{ item.title.value }}</h3>
                {%- if item.text.value != blank -%}
                  <p class="chx-txbenefits__text">{{ item.text.value | newline_to_br }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for block in blocks -%}
            <li class="chx-txbenefits__item" {{ block.shopify_attributes }}>
              <span class="chx-txbenefits__number" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <div class="chx-txbenefits__copy">
                <h3 class="chx-txbenefits__name">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}
                  <p class="chx-txbenefits__text">{{ block.settings.text }}</p>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ol>
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .chx-txbenefits {
    padding-block: var(--space-24);
    background: var(--surface-card);
  }

  .chx-txbenefits__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .chx-txbenefits__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .chx-txbenefits__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: var(--space-16);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chx-txbenefits__item {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding-block: var(--space-4);
    border-bottom: var(--border-w) solid var(--border-strong);
  }

  .chx-txbenefits__number {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: var(--surface-dark);
    color: var(--text-on-dark);
    font-family: var(--font-ui);
    font-size: var(--font-size-body-small);
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .chx-txbenefits__copy {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    min-width: 0;
  }

  .chx-txbenefits .chx-txbenefits__name {
    margin: 0;
    color: var(--text-heading);
    font-family: var(--font-ui);
    font-size: var(--font-size-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .chx-txbenefits__text {
    margin: 0;
    color: var(--text-body);
    font-size: var(--font-size-body);
    line-height: 1.45;
  }

  @media (max-width: 1024px) {
    .chx-txbenefits {
      padding-block: var(--space-16);
    }

    .chx-txbenefits__grid {
      column-gap: var(--space-8);
    }
  }

  @media (max-width: 767px) {
    .chx-txbenefits {
      padding-block: var(--space-10);
    }

    .chx-txbenefits__inner {
      gap: var(--space-6);
    }

    .chx-txbenefits__grid {
      grid-template-columns: 1fr;
    }

    .chx-txbenefits__item {
      gap: var(--space-4);
    }

    .chx-txbenefits__number {
      width: 52px;
      height: 52px;
    }

    .chx-txbenefits__text {
      font-size: var(--font-size-body-small);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Treatment benefits",
  "tag": "section",
  "class": "chopinrx-tx-benefits-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Items come from the product's Why benefits custom field. The blocks below are only used when it is empty. [product] is replaced by the product name."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "02 / Benefits"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What [product] can do for you"
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Energy"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Treatment benefits"
    }
  ]
}
{% endschema %}
